mml = Import('sendmml.hsl3')
data = Import('get_configured_data.hsl3')
counters = Import('energy_counters.hsl3')

def Check_OSS()
'''
The deployment-specific IP-to-zone mapping was removed from this public archive.
'''
    return "EXAMPLE_ZONE"
end 



def write_to_file(path, string) 
    if (IsFile(path)==False)
        fp1 = Open(path,'a')
        #Print(f + ' file has been created!')
        fp1.close()
    end  
    fp = Open(path, "w+")
    fp.write(string)
    fp.close()
end 

def write_to_csv(file, message)
    f = Open(GetOutputPath() + "//" + file , 'w')  
    WriteCSVFile(f, message) 
end


def map_cell_on_sectoreqm(sectoreqm, trx_group_0, trx_group_1, local_cell)
    data = {item: trx_group_0[i] for i, item in enumerate(sectoreqm)}
    for i, item in enumerate(trx_group_1)
        for k, v in data.items()
            if v == item
                data[k] = local_cell[i]
            end
        end
       
    end 
    
    return list(data.values())
    
end


def cell_data() -> dict
    """
    Returns a dictionary. The keys are the technologies and the values are the 
    cell ids and sector equipments for all technologies
    cell_details = {'eNodeB: [[0, 1, 2], [90, 91, 92]], 'GBTS: [[3111, 3112, 3113], [60, 61, 62]]}
    """
    apps = data.ne_type()
    cell_details = {}
    if 'eNodeB' in apps
        p_lst_cell, rpt_lst_cell, getresult_lst_cell, lte_cell_details = mml.sendmmlcommand('LST EUCELLSECTOREQM:;', 1, 'Local cell ID', 'Sector equipment ID')
        cell_details['eNodeB'] = lte_cell_details
    end
    if 'NodeB' in apps
        p_lst_ucell, rpt_lst_ucell, getresult_lst_ucell, umts_cell_details = mml.sendmmlcommand('LST ULOCELLSECTOREQM:;', 1, 'Local Cell ID', 'Sector Equipment ID')
        cell_details['NodeB'] = umts_cell_details
    end
    if 'GBTS' in apps
        p_lst_gcell, rpt_lst_gcell, getresult_lst_gcell, gsm_cell_details = mml.sendmmlcommand('LST GTRXGROUPSECTOREQM:;', 1, 'TRX Group ID', 'Sector Equipment ID')
        p_lst_gcell_1, rpt_lst_gcell_1, getresult_lst_gcell_1, gsm_cell_details_1 = mml.sendmmlcommand('LST GTRXGROUP:;', 1, 'TRX Group ID', 'Local Cell ID')
        if len(gsm_cell_details[1]) != len(gsm_cell_details_1[1])
            cells = map_cell_on_sectoreqm(gsm_cell_details[1], gsm_cell_details[0], gsm_cell_details_1[0], gsm_cell_details_1[1])
            gsm_cell_details_1[1] = cells
        end
        cell_details['GBTS'] = [gsm_cell_details_1[1], gsm_cell_details[1]]    
    end
    return cell_details
end


def get_rru(sectoreqm: str) -> list
    """
    it gets the RRU description and the cabinet, subrack and slot numbers
    """
    rru_details = []
    p_lst_sectoreqm, rpt_lst_sectoreqm, getresult_lst_sectoreqm, board_ports = mml.sendmmlcommand('LST SECTOREQM:SECTOREQMID={};'.format(sectoreqm), 1, 'Subrack No.', 'Cabinet No.', 'Slot No.', entry=1)
    for item in board_ports[0]
        p_dsp_brd_mfrinfo, rpt_dsp_brd_mfrinfo, getresult_dsp_brd_mfrinfo, rru_data = mml.sendmmlcommand('DSP BRDMFRINFO:CN=0,SRN={},SN=0;'.format(item), 1,'Description')
        if rru_data[0]
            rru_details.append(rru_data[0][0])
        else
            rru_details.append('NULL')
        end
    end
    return rru_details, board_ports[0], board_ports[1], board_ports[2]
end


def average_per_rru(site, rru_subrack)
    content = counters.get_counters(site, 1593835545, [1593835836])
    energy_sum = 0
    inc = 0
    for item in content
        if rru_subrack in item
            inc += 1
            energy_sum += float(item[-1])
        end
    
    end
    avg_power = energy_sum / inc
    return avg_power
end


