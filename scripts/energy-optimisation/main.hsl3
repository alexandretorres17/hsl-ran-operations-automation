def nodes() -> list
    """ get the NEs """
    bts3900 = GetNELstByType("BTS3900")
    bts3900lte = GetNELstByType("BTS3900 LTE")
    egbts = GetNELstByType("eGBTS")
    bts5900 = GetNELstByType("BTS5900")

    ## Alteração Spain
    
    return bts3900 + bts3900lte + egbts + bts5900
end

def Get_sites()
'''
Function to list existing 4G NEs on OSS (based on conditions)
'''
    nelist = GetNELst()
    neList_final=list()

   for ne in nelist
        if not ne.startswith(("BSC","RNC"))
            neList_final.append(ne)
        end
    end    
    return neList_final
end


########### global scope ################
sites = Get_sites()
oss_area = Check_OSS()
content = ''
csv_content = [['Site', 'technology', 'cell ID', 'RRU', 'RRU description', 'OSS']]

for site in sites
    ret = ConnectNE(site)
    if ret != 0
        c_data = cell_data()
        for k, v in c_data.items()
            # k is the key within the dictionary and represents the technology
            # v is the value within the dictionary; a list consisting of 2 elements -> a list of cell IDs and a list of sector eqm IDs
            for i, sector in enumerate(v[1])
                rru_details, subrack, cabinet, slot = get_rru(v[1][i])
                if rru_details
                    for j, detail in enumerate(set(subrack))
                        # average_power = average_per_rru(site, subrack[j])
                        Print('{};{};{};{}/{}/{};{};{}'.format(site, k, v[0][i], cabinet[j], subrack[j], slot[j], rru_details[j], oss_area).split(';'))
                        # content += '{} -> {} -> cell ID: {} -> RRU: 0/{}/0 -> RRU description: {}\n'.format(site, k, v[0][i],  subrack, rru_details[0].split(',')[3])
                        csv_content.append('{};{};{};{}/{}/{};{};{}'.format(site, k, v[0][i], cabinet[j], subrack[j], slot[j], rru_details[j], oss_area).split(';'))
                    end
                end
            end 
        end
    end
end

write_to_csv('energy_csv.csv', csv_content)

