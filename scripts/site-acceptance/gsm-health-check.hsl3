################ Check Neighbours Relations: ################
def Check_Neighbours(Cell_ID)

    Mail_Neighbour = "\n    Neighbour Relation Check:\n"
    Intra = Check_NeighboursUTRAN_Intra(Cell_ID)
    Inter = Check_NeighboursUTRAN_Inter(Cell_ID)
    NLTEG = Check_NeighboursLTE(Cell_ID)
    N2G = Check_Neighbours2G(Cell_ID)
    Mail_Neighbour += str(Intra)+str(Inter)+str(NLTEG)+str(N2G)
 
    return Mail_Neighbour
end

################ Check S1 Interfaces ################
def Check_S1Interfaces()
    
    ClearMMLBuffer()
    Mail_S1Interface = "\n    S1-MME interface state:\n"
    @DSP S1INTERFACE:;
    mml = GetMMLReport()
    strS1Interface = ParseMMLRpt(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strS1Interface or GetResultCode(strS1Interface) != '0' 
        Print('[ERROR]  FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strS1Interface), GetResultCause(strS1Interface))) 
        Mail_S1Interface += "[ERROR]  FAILED Command Execution "+str(GetMMLCmd(strS1Interface))+"Reason: "+ str(GetResultCause(strS1Interface))+"\n"
        return Mail_S1Interface 
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strS1Interface) < 1 
        Print('[ERROR]  No proper entry information found')
        Mail_S1Interface += '[ERROR]  No proper entry information found\n'
        return Mail_S1Interface 
    end
    
    # Check Status
    Num_S1Interface = GetRecordNum(strS1Interface,0)      
    for n in range (Num_S1Interface)
        valueS1 = GetAttrValueByIdx(strS1Interface,0,5,n)
        #Print(valuestate)
        if valueS1 != 'Normal'
            Print("NOK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByIdx(strS1Interface,0,5,n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n)))
            Mail_S1Interface += "NOK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByIdx(strS1Interface,0,5,n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n))+"\n"        
        else
            valueSCTP = GetAttrValueByIdx(strS1Interface,0,6,n)
             if valueSCTP != 'Normal'
                Print("NOK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByIdx(strS1Interface,0,5,n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n)))
                Mail_S1Interface += "NOK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByIdx(strS1Interface,0,5,n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n))+"\n"
            else
                Print("OK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByIdx(strS1Interface,0,5,n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n)))
                Mail_S1Interface += "OK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByIdx(strS1Interface,0,5,n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n))+"\n"
            end
        end
    end
    
    return Mail_S1Interface
end

################ Check S1-U Interface State ################ 
def Check_IP(IPPath)

    ClearMMLBuffer()
    Mail_IP = ""
    CMD = ("DSP IPPATH:PATHID="+str(IPPath)+";")
    #Print (CMD)
    SendMML(CMD)
    #@STR RFTEST:TSTTYPE=PIMOFFLINE,CN=0,SRN=5,SN=2;
    mml = GetMMLReport(-1)
    #Print(mml)
    strIP = ParseMMLRpt(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strIP or GetResultCode(strIP) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strIP), GetResultCause(strIP)) ) 
        Mail_IP += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strIP))+"Reason: "+ str(GetResultCause(strIP))+"\n"
        return Mail_IP 
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strIP) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_IP += '[ERROR] No proper entry information found\n'      
        return Mail_IP 
    end
    
    # Check Status  
    value_IP = GetAttrValueByName(strIP,0,"IP Path Check Result",0)
    if value_IP == 'Normal'
        Print("OK ... IP Path ID "+str(IPPath)+": Not possible to check due to "+str(GetAttrValueByName(strIP,0,"IP Path Check Result",0)))
        Mail_IP += "OK ... IP Path ID "+str(IPPath)+": Not possible to check due to "+str(GetAttrValueByName(strIP,0,"IP Path Check Result",0))
    else
        Print("NOK ... IP Path ID "+str(IPPath)+": Not possible to check due to "+str(GetAttrValueByName(strIP,0,"IP Path Check Result",0)))
        Mail_IP += "NOK ... IP Path ID "+str(IPPath)+": Not possible to check due to "+str(GetAttrValueByName(strIP,0,"IP Path Check Result",0))
    end

    
    return Mail_IP
end

################ Check S1-U Interface State (IPPath) ################ 
def Check_IPPath()

    ClearMMLBuffer()
    Mail_IPPath = "\n    S1-U interface state\n"
    @LST CNOPERATORIPPATH:;
    mml = GetMMLReport()
    strIPPath = ParseMMLRpt(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strIPPath or GetResultCode(strIPPath) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strIPPath), GetResultCause(strIPPath))) 
        Mail_IPPath += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strIPPath))+"Reason: "+ str(GetResultCause(strIPPath))
        return Mail_IPPath
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strIPPath) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_IPPath += '[ERROR] No proper entry information found\n'
        return Mail_IPPath 
    end
    
    # Check Status
    Num_IPPath = GetRecordNum(strIPPath,0)      
    for o in range (Num_IPPath)
        IPPath = str(GetAttrValueByIdx(strIPPath,0,0,o)) #IP Path ID
        Mail_IP = Check_IP(IPPath)
        Mail_IPPath += Mail_IP+"\n"
    end
    
    return Mail_IPPath
end   

################ Check VSWR ################
def Check_VSWR(NEName)

    ClearMMLBuffer()
    Mail_VSWR = "\n    VSWR Remote Test:\n"
    CMD = ("STR BTSVSWRTST: IDTYPE=BYNAME, BTSNAME=\""+ NEName+"\", TMODE=NON_FDR;")
    #Print (CMD)
    SendMML(CMD)
	#@STR BTSVSWRTST: IDTYPE=BYNAME, BTSNAME="GSM_SITE_EXAMPLE", TMODE=NON_FDR;
    mml = GetMMLReport(-1)

	# mml='''+++    CONTROLLER_EXAMPLE        2014-03-31 17:05:10 DST
# O&M    #EXAMPLE
# %%/*EXAMPLE*/STR BTSVSWRTST: IDTYPE=BYNAME, BTSNAME="GSM_SITE_EXAMPLE", TMODE=NON_FDR;%%
# RETCODE = 0  Progress report, Execution succeeded.

# Progress Report
# ---------------
       # Report Type  =  VSWR Query
            # Status  =  Success
        # Session ID  =  67896546

# VSWR Query Result
# -----------------
 # BTS Index  BTS Name  Cell No.  Board No.  Antenna Tributary No.  VSWR  

 # 254        GSM_SITE_EXAMPLE  126       0          Tributary A            1.25  
 # 254        GSM_SITE_EXAMPLE  255       0          Tributary B            1.10  
 # 254        GSM_SITE_EXAMPLE  124       1          Tributary A            1.23  
 # 254        GSM_SITE_EXAMPLE  255       1          Tributary B            1.10  
# (Number of results = 4)

# ---    END'''
    #Print(mml)
    strVSWR = ParseMMLRpt(mml)
    dic.update({'Log':str(dic['Log'])+mml})
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strVSWR or GetResultCode(strVSWR) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strVSWR), GetResultCause(strVSWR))) 
        Mail_VSWR += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strVSWR))+"Reason: "+ str(GetResultCause(strVSWR))+"\n"
		dic.update({"VSWR":"ERROR"})
        return Mail_VSWR 
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strVSWR) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_VSWR += '[ERROR] No proper entry information found\n'
        dic.update({"VSWR":"ERROR"})
        return Mail_VSWR 
    end
    
    # Check Status     
	OK_Count = 0
    Num_VSWR=GetRecordNum(strVSWR,1)       
    for j in range (Num_VSWR)
        value_sector = GetAttrValueByIdx(strVSWR,1,2,j)
        value_VSWR = GetAttrValueByIdx(strVSWR,1,5,j)
        if value_sector!= ""
            if value_sector != 'NULL'
				if	value_VSWR != 'NULL'
					if float(value_VSWR) >= 1.5
						Print("NOK ... VSWR Value of Cell Nº: "+str(GetAttrValueByIdx(strVSWR,1,2,j))+" and Antenna "+str(GetAttrValueByIdx(strVSWR,1,4,j))+" is: "+str((value_VSWR)))
						Mail_VSWR += "NOK ... VSWR Value of Cell Nº: "+str(GetAttrValueByIdx(strVSWR,1,2,j))+" and Antenna "+str(GetAttrValueByIdx(strVSWR,1,4,j))+" is: "+str((value_VSWR))+"\n"    
						OK_Count += 1
					else
						Print("OK ... VSWR Value of Cell Nº: "+str(GetAttrValueByIdx(strVSWR,1,2,j))+" and Antenna "+str(GetAttrValueByIdx(strVSWR,1,4,j))+" is: "+str((value_VSWR)))
						Mail_VSWR += "OK ... VSWR Value of Cell Nº: "+str(GetAttrValueByIdx(strVSWR,1,2,j))+" and Antenna "+str(GetAttrValueByIdx(strVSWR,1,4,j))+" is: "+str((value_VSWR))+"\n"   
					end
				else
					Print("[ERROR] VSWR Value = NULL")
					Mail_VSWR += "[ERROR] VSWR Value = NULL\n"
					OK_Count += 1	
				end
			else
				Print("[ERROR] Sector ID = NULL")
				Mail_VSWR += "[ERROR] Sector ID = NULL\n"
				OK_Count += 1	
			end
        else 
            Print("[ERROR] ERROR IN PARSING OUTPUT. COMMAND NEEDS TO BE PERFORMED AGAIN")
            Mail_VSWR += "[ERROR] ERROR IN PARSING OUTPUT. COMMAND NEEDS TO BE PERFORMED AGAIN\n"
			OK_Count += 1
        end
    end
    
	if  OK_Count <= 0
        dic.update({"VSWR":"OK"})
    else
        dic.update({"VSWR":"***** NOT OK *****"})
    end 
	
    return Mail_VSWR
end


