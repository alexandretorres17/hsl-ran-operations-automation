        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetAlmMMLCmd(strAlarmBSC), GetAlmResultCause(strAlarmBSC)) ) 
        Mail_Alarms_BSC += "[ERROR] FAILED Command Execution "+str(GetAlmMMLCmd(strAlarmBSC))+"Reason: "+ str(GetAlmResultCause(strAlarmBSC))+"\n"
		dic.update({"Active Alarms on BSC":"ERROR"})
        return Mail_Alarms_BSC
