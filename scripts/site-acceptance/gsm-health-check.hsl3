################ Main function of the program, responsible for basic logic of the program. ################  
def Main(BSCName,NEName) 
    loginInfo=CreateLoginInfo('192.0.2.10')
    # Send MML commands to NEs and parse messages to obtain the required data 
    Report_Begin_Time = AscTime(LocalTime())
    Mail_MntMode,Mail_Alarms_BSC,Mail_Alarms_Log,Mail_SW,Mail_Cell,Mail_ActualCell,Mail_VSWR,Mail_Alarms_BSC_After,Mail_Alarms_Site,Mail_Alarms_Log_Site,Mail_PTPBVCI,Mail_NSE,Site_name = ExecMMLCmd(BSCName,NEName)
	
	Print("Overall Status")
    Print("Maintenance Mode = " + str(dic['Maintenance Mode']))
    Print("Active Alarms Site= " + str(dic['Active Alarms Site']))
    # Print("Licenses = " + str(dic['Licenses']))
    Print("Software Version = " + str(dic['Software Version']))
    Print("VSWR = " + str(dic['VSWR']))
    Print("Cells Status = " + str(dic['Cells Status']))
	Print("Cells Operational Status = " + str(dic['Cells Status']))
	Print("PTPBVCI Status = " + str(dic['PTPBVCI Status']))
	Print("Cells by Operator (Assuming TEF Cell name contains 'T')= " + str(dic['Cells by Operator']))
	Print("Active Alarms on BSC = " + str(dic['Active Alarms on BSC']))
    # Print("Neighbours Relations = " + str(dic['Neighbours Relations']))
    Print("Alarms Log = " + str(dic['Alarms Log']))
    Print("Alarms Log from the Last 10 Days = " + str(dic['Alarms Log_10days']))
	Print("Active Alarms on BSC After Tests = " + str(dic['Active Alarms on BSC After Tests']))
	Print("Alarms Log Site = " + str(dic['Alarms Log Site']))
	Print("Alarms Log from the Last 10 Days Site = " + str(dic['Alarms Log_10days Site']))
	
	if NEName != Site_name
		Overall = "\nOverall Status for site "+NEName+" Co-MPT Site "+Site_name+"\n\n"
	else
		Overall = "\nOverall Status for site "+NEName+"\n\n"
	end 
	
    Overall += "\tMaintenance Mode = " + str(dic['Maintenance Mode']) + "\n\tActive Alarms Site= " + str(dic['Active Alarms Site']) +"\n\tSoftware Version = " + str(dic['Software Version']) + "\n\tCells Status = " + str(dic['Cells Status']) + "\n\tCells Operational Status = " + str(dic['Cells Operational Status'])+ "\n\tPTPBVCI Status = " + str(dic['PTPBVCI Status'])+ "\n\tCells by Operator (Assuming TEF Cell name contains 'T') = " + str(dic['Cells by Operator']) + "\n\tActive Alarms on BSC = " + str(dic['Active Alarms on BSC']) + "\n\tVSWR = " + str(dic['VSWR']) + "\n\tAlarms Log = " + str(dic['Alarms Log']) + "\n\tAlarms Log from Last 10 Days = " + str(dic['Alarms Log_10days'])+ "\n\tAlarms Log Site = " + str(dic['Alarms Log Site']) + "\n\tAlarms Log from Last 10 Days Site = " + str(dic['Alarms Log_10days Site'])+"\n\tActive Alarms on BSC After Tests = " + str(dic['Active Alarms on BSC After Tests'])
    Report_End_Time_1 = AscTime(LocalTime())
    #Overall += "\n\n"+str(NEName) +"\t" + str(dic['Maintenance Mode']) + "\t" + str(dic['SW_Version']) + "\t" + str(dic['Cells Status']) + "\t" + str(dic['Cells by Operator']) + "\t" + str(dic['Active Alarms on BSC']) + "\t" + str(dic['VSWR']) + "\t" + str(Report_End_Time_1)
    
	
    #--------------
    Report_End_Time = AscTime(LocalTime())
    Data_2GHC = "\n***** GSM ACCEPTANCE REPORT ***** \n\nVF Site Ref: "+NEName+"\nBSC Ref: "+BSCName+"\nExecution Begin Date: "+ Report_Begin_Time+"\n\n"
    Data_2GHC += (str(Mail_MntMode)+str(Mail_Alarms_BSC)+str(Mail_Alarms_Log)+str(Mail_SW)+str(Mail_Cell)+str(Mail_ActualCell)+str(Mail_NSE)+str(Mail_PTPBVCI)+str(Mail_VSWR)+str(Mail_Alarms_Site)+str(Mail_Alarms_Log_Site)+str(Mail_Alarms_BSC_After))
    Data_2GHC += "\n\nExecution End Date: "+ Report_End_Time+"\n"+"\n*****  END OF REPORT  *****"
	Path = "/export/ossuser/.Acceptance_Logs/2G_"+NEName+".txt"
    file_open = Open(Path,'w')
    file_open.write(Data_2GHC)
	file_open.close()
	Path_Log = "/export/ossuser/.Acceptance_Logs/2G_"+NEName+"_LOG.txt"
    Info_Log = str(dic['Log'])
    Log_Info=str(Info_Log)
    log_open = Open(Path_Log,'w')
    log_open.write(Log_Info)
    log_open.close()
	
	All_Path = []
	All_Path.append(Path)
	All_Path.append(Path_Log)
	
	
	Print(str(mail))
	#Print(Data_2GHC)
    Print("Sending Email........")
    mailInfo = CreateMailInfo()
    #mailInfo['TO_ADDR']=("portfolio@example.invalid","portfolio@example.invalid","portfolio@example.invalid")
    mailInfo['TO_ADDR'] = mail
    mailInfo['CC_ADDR']=("portfolio@example.invalid")
    mailInfo['FROM_ADDR']='portfolio@example.invalid'
    mailInfo['MAIL_SUBJECT']='GSM Health Check '+str(NEName)
    mailInfo['MAIL_BODY']= str(Overall)
	mailInfo['MAIL_ATTACH'] = All_Path

    result=SendMail(mailInfo)
    Print(result)
    

    #Sleep(10)
    
   
end

