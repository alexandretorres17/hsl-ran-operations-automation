			x+=1
			#Print("          "+str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+(GetAlmName(Alarms_Parse,p))+" || "+str(GetAlmLocationInfo(Alarms_Parse,p)))
