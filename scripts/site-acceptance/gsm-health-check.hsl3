################ Check Alarms Log ################
def Check_Alarms_Log_10days_Site(NEName)

    ClearMMLBuffer()
    Mail_Alarms_Log_10days = "\n    Alarms Log 10 Days Check:\n"
    
    #Get the GMT time.
    secs = Time()
    #Output the GMT time.
    #Add 3600 S, that is, one hour, to secs. Subtract 864000 (10 days) Then, output the result.
	time_ref = StrfTime("%Y-%m-%d %H:%M:%S", GMTime(secs + 3600-864000))
    #Print(time_ref)
    year=time_ref[0:4]
    month=time_ref[5:7]
    day=time_ref[8:10]
	
	
	#@LST ALMLOG:ALMTP=ALL,SD=2014&08&22;
    CMD = ("LST ALMLOG:ALMTP=ALL,SD="+year+"&"+month+"&"+day+";")
    #Print (CMD)
    SendMML(CMD)

    mml = GetMMLReport()
    strAlarm_Log_10days = ParseAlmRpt(mml)
    dic.update({'Log':str(dic['Log'])+mml})
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strAlarm_Log_10days or GetAlmResultCode(strAlarm_Log_10days) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetAlmMMLCmd(strAlarm_Log_10days), GetAlmResultCause(strAlarm_Log_10days)) ) 
        Mail_Alarms_Log_10days += "[ERROR] FAILED Command Execution "+str(GetAlmMMLCmd(strAlarm_Log_10days))+"Reason: "+ str(GetAlmResultCause(strAlarm_Log_10days))+"\n"
        dic.update({'Alarms Log site':'ERROR'})
        dic.update({"Alarms Log_10days Site":'ERROR'})
        return Mail_Alarms_Log_10days
    end
    
    OK_Count = 0  
    if GetAlmRptNum(strAlarm_Log_10days) <= 0
        Print("OK ... No Alarm Log from Last 10 Days in %s" %NEName)
        Mail_Alarms_Log_10days+= ("OK ... No Alarm Log from Last 10 Days in %s" %NEName)+"\n"
    else   
        Print("NOK ... Alarm Log from Last 10 Days in %s" %NEName)
        Mail_Alarms_Log_10days += ("NOK ... Alarm Log from Last 10 Days in %s" %NEName)+"\n"
		log_print, limit_check, log_print_filter = Print_Alarms_Log_10days_Site(strAlarm_Log_10days)
        Mail_Alarms_Log_10days += log_print
		OK_Count += 1
    end
	
	if  OK_Count <= 0
        dic.update({"Alarms Log Site":"No Alarm Log"})
		dic.update({"Alarms Log_10days Site":"No Alarm Log"})
	elif limit_check == "notok" and log_print_filter != ""
		dic.update({"Alarms Log Site":"***** NOT OK *****"})
		dic.update({"Alarms Log_10days Site":""+ str(log_dic.items())}) 
    else
        dic.update({"Alarms Log Site":"NOT OK"}) ## Sem as * quer dizer que tem log mas nenhum alarme com mais de 3x então a macro do excel vai ignorar
		dic.update({"Alarms Log_10days Site":""+ str(log_dic.items())}) 
    end
    #Print(str(log_dic['SCTP Link Congestion']))
    #Print(str(log_dic.items()))
     
    return Mail_Alarms_Log_10days
end

################ Print Alarms Log ################
def Print_Alarms_Log_10days_Site(Alarms_Parse)
   
    Alarms_Parse
    Mail_Alarms_Log_Print_10days="    Site Had the Following Alarms Log in the Last 10 Days:\n"
    log_dic.clear()
	Alarm_log_filter = ""
	limit_error = ""
    for p in range(GetAlmRptNum(Alarms_Parse))
        Print("          "+str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p)))
        Mail_Alarms_Log_Print_10days += "          "+ str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+"\n"
       
        		for whitlist in whitelist_alarm_info
			if (whitlist in str(GetAlmLocationInfo(Alarms_Parse,p))) or whitlist in (str(GetAlmName(Alarms_Parse,p)))
				break
			else
				continue
			end
		else
			if str(GetAlmName(Alarms_Parse,p))not in log_dic
				log_dic.update({str(GetAlmName(Alarms_Parse,p)):1})
			else
				log_dic.update({str(GetAlmName(Alarms_Parse,p)):int(log_dic[str(GetAlmName(Alarms_Parse,p))])+1})
				if (log_dic[str(GetAlmName(Alarms_Parse,p))] >= 5)
					limit_error = "notok"
				end
			end
			Alarm_log_filter += str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+" - "+str(GetAlmLocationInfo(Alarms_Parse,p))+"\n"
		end
    end
   
    return Mail_Alarms_Log_Print_10days, limit_error, Alarm_log_filter
end



def ExecMMLCmd(BSCName,NEName)
    # Send MML command to NE to obtain messages. Being restricted by the running environment, we use constant instead.  
    
	#################################################################Connect to Network Element Parent
	ConnectNE(BSCName) 
Sleep(2)
	################ Check Maintenance Mode 
    Mail_MntMode = Check_MmtMode(NEName)  
    #Mail_MntMode="\nCheck Maintenance Mode  - Function Commented\n" 
    # dic.update({'Maintenance Mode':'Function Commented'})
		
	################ Check if there are active Alarms
	Mail_Alarms_BSC = Check_Alarms_BSC(NEName)   
	#Mail_Alarms_BSC ="\nCheck Active Alarms on BSC - Function Commented\n" 
	# dic.update({'Active Alarms on BSC':'Function Commented'}) 
	
	################ Check Alarms Log
    Mail_Alarms_Log = Check_Alarms_Log(NEName)   
    # Mail_Alarms_Log = "\nCheck Active Alarms - Function Commented\n" 
    # dic.update({'Alarms Log':'Function Commented'})
    # dic.update({'Alarms Log_10days':'Function Commented'})
	
	################ Check NSE
    Mail_NSE,NSEI_VDF_ID,NSEI_TEF_ID = Check_NSE()  
    # Mail_NSE = "\nCheck Active Alarms - Function Commented\n" 
    # dic.update({'NSE':'Function Commented'})
    # dic.update({'NSE':'Function Commented'})
	

	
	
	################ Check Licenses
	#Mail_License = Check_Licenses() 
	#Mail_License="\nCheck Licenses - Function Commented\n" 
	
	################ Check Software Version
	Mail_SW = Check_SW(NEName)
    # Mail_SW="\nCheck Software Version - Function Commented\n"  
	# dic.update({'Software Version':'Function Commented'})
    # dic.update({'SW_Version':'Function Commented'})
	
	Mail_SW_BSC = Check_SW_BSC()
	
	if "R016" in str(dic['SW_Version_BSC'])
		################ Check VSWR SRAN9
		# Mail_VSWR = Check_VSWR_SRAN9(NEName)  
		Mail_VSWR="\nCheck VSWR - Function Commented\n" 
		dic.update({'VSWR':'Function Commented'})	
	
	elif "R" in str(dic['SW_Version_BSC'])
		################ Check VSWR 
		# Mail_VSWR = Check_VSWR(NEName)     
		Mail_VSWR="\nCheck VSWR - Function Commented\n" 
		dic.update({'VSWR':'Function Commented'})	
	
	else
		################ Check VSWR 
		# Mail_VSWR = Check_VSWR(NEName)     
		Mail_VSWR="\nCheck VSWR - Function Commented\n" 
		dic.update({'VSWR':'Function Commented'})	
	
	end

	################ Check Administrative Cell State   
	Mail_Cell,Cell_ID = Check_CellState(NEName)  
	# Mail_Cell="\nCheck Cell State - Function Commented\n" 
    # dic.update({'Cells Status':'Function Commented'})    
    # dic.update({'Cells by Operator':'Function Commented'})
  	
	################ Check Operational Cell State   
	Mail_ActualCell = Check_ActualCellState(Cell_ID)
	# Mail_ActualCell="\nCheck Operational Cell State - Function Commented\n" 
    # dic.update({'Cells Operational Status':'Function Commented'})   

	################ Check PTPBVCI
	Mail_PTPBVCI=Check_PTPBVC(Cell_ID,NSEI_VDF_ID,NSEI_TEF_ID) 
	# Mail_PTPBVCI="\nCheck Cell State - Function Commented\n" 
    # dic.update({'PTPBVCI Status':'Function Commented'})  	
	
	################ Check Neighbours Relations
	#Mail_Neighbour = Check_Neighbours(Cell_ID)
	#Mail_Neighbour="\nCheck Neighbours Relations - Function Commented\n"  
	
	Sleep(10)
	
	################ Check if there are active Alarms after all tests
	Mail_Alarms_BSC_After = Check_Alarms_BSC_After(NEName)   
	#Mail_Alarms_BSC_After ="\nCheck Active Alarms on BSC after all tests - Function Commented\n" 
	# dic.update({'Active Alarms on BSC After Tests':'Function Commented'})
	
	Mail_site_name=NEName
	################ Check Co-MPT
	Site_name2 = []
	Site_name = NEName
	if "Co_MPT" in Mail_SW
		NE_Num =  ''.join([j for j in NEName if j.isdigit()]) 
		NE_Num = str(NE_Num).zfill(5)
		# Print(str(NEName)+"-"+str(NE_Num))
		for k in Element_CoMPT
		   if NE_Num in k
			   #Print (k)
			   Site_name2.append(k)
			end
		end
		
		
		for site in Site_name2
			xpto=ConnectNE(site)
			# Sleep(2)
		
			ClearMMLBuffer()
			xpto=SendMML("LST GBTSFUNCTION:;")
			#Print(str(xpto))
			mml = GetMMLReport()
			strnode = ParseMMLRpt(mml)
			value_node = GetAttrValueByName(strnode,0,"GBTS Function Name",0)
			
			Print("dentro="+str(value_node))
			Print("dentro="+str(Site_name))
			if str(value_node) == str(Site_name)
				Site_name=site
			end			
		end	
		
		# Print(Site_name)
				
		Mail_site_name=Site_name
		xpto=ConnectNE(Site_name)
		Mail_SW = Check_SW_Co_MPT()
		# Mail_SW="\nCheck Software Version - Function Commented\n"  
		# dic.update({'Software Version':'Function Commented'})
		# dic.update({'SW_Version':'Function Commented'})
		
		################ Check if there are active Alarms
		Mail_Alarms_Site = Check_Alarms_Site(NEName)   
		# Mail_Alarms="\nCheck Active Alarms - Function Commented\n" 
		# dic.update({'Active Alarms':'Function Commented'})
		# Info_Log_Alarms ="\nCheck Active Alarms - Function Commented\n"
		
		################ Check Alarms Log
		Mail_Alarms_Log_Site = Check_Alarms_Log_Site(NEName)   
		# Mail_Alarms_Log="\nCheck Active Alarms - Function Commented\n" 
		# dic.update({'Alarms Log':'Function Commented'})
		# dic.update({'Alarms Log_10days':'Function Commented'})
		# Info_Log_Alarms_Log ="\nCheck Alarms Log - Function Commented\n"
	else
		################ Check if there are active Alarms
		# Mail_Alarms_Site = Check_Alarms_Site(NEName)   
		Mail_Alarms_Site="\nCheck Active Alarms - NOT Co_MPT\n" 
		dic.update({'Active Alarms Site':'NOT Co_MPT'})
		
		################ Check Alarms Log
		# Mail_Alarms_Log_Site = Check_Alarms_Log_Site(NEName)   
		Mail_Alarms_Log_Site="\nCheck Active Alarms Site - NOT Co_MPT\n" 
		dic.update({'Alarms Log Site':'NOT Co_MPT'})
		dic.update({'Alarms Log_10days Site':'NOT Co_MPT'})
	end

	#################################################################NOT IN USE
	
	################ Check if there are active Alarms
	#Mail_Alarms = Check_Alarms()   
	#Mail_Alarms="\nCheck Active Alarms - Function Commented\n" 
	
	################ Check RF Interference
	#Mail_Board = Check_Board()
	#Mail_Board="\nCheck RF Interference - Function Commented\n" 
	
	################ Check S1 Interfaces
	#Mail_S1Interface = Check_S1Interfaces()
	#Mail_S1Interface="\nCheck S1 Interfaces - Function Commented\n"     
	
	################ Check S1-U Interface State
	#Mail_IPPath = Check_IPPath()
	#Mail_IPPath="\nCheck S1-U Interface State - Function Commented\n" 
	
	return Mail_MntMode,Mail_Alarms_BSC,Mail_Alarms_Log,Mail_SW,Mail_Cell,Mail_ActualCell,Mail_VSWR,Mail_Alarms_BSC_After,Mail_Alarms_Site,Mail_Alarms_Log_Site,Mail_PTPBVCI,Mail_NSE,Mail_site_name
end


