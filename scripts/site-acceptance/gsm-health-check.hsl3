################ Check NSE ################ 
def Check_NSE()
	ClearMMLBuffer()
    Mail_NSE = "\n\tNSE Check:\n"
	Print("\n\tNSE Check:")
	NSEI_VDF_ID=[]
	NSEI_TEF_ID=[]
	#LST NSE:;
	CMD = ("LST NSE:;")
	#Print (CMD)
	SendMML(CMD)
	mml = GetMMLReport()
	strCell = ParseMMLRpt(mml)
	dic.update({'Log':str(dic['Log'])+mml})
	
	# If MML command does not execute successfully, the system prompts error and does not continue processing  
	if not strCell or GetResultCode(strCell) != '0' 
		Print('\t    [ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strCell), GetResultCause(strCell))) 
		Mail_NSE += "\t    [ERROR] FAILED Command Execution "+str(GetMMLCmd(strCell))+"Reason: "+ str(GetResultCause(strCell))
		dic.update({"NSE Status":"ERROR"})
		return Mail_NSE
	end
	
	# If MML report has no corresponding entry information, the system prompts error and does not continue processing  
	if GetObjNum(strCell) < 1 
		 Print('\t    [ERROR] No proper entry information found')
		Mail_NSE += '\t    [ERROR] No proper entry information found\n'
		dic.update({"NSE Status":"ERROR"})
		return Mail_NSE 
	end
	
	Num_NSEI = GetRecordNum(strCell,0)
	for l in range (Num_NSEI)
		Operator=(GetAttrValueByName(strCell,0,"Operator Name",l))
		Print("\t    NSE Identifier = "+ str(GetAttrValueByName(strCell,0,"NSE Identifier",l))+" -> "+str(Operator))
		Mail_NSE += "\t    NSE Identifier = "+ str(GetAttrValueByName(strCell,0,"NSE Identifier",l))+" -> "+str(Operator)+"\n"
		if 'Operator_A' in Operator
			NSEI_VDF_ID.append(GetAttrValueByName(strCell,0,"NSE Identifier",l))
		else
			NSEI_TEF_ID.append(GetAttrValueByName(strCell,0,"NSE Identifier",l))
		end
	end

return	Mail_NSE,NSEI_VDF_ID,NSEI_TEF_ID
end

################ Check PTPBVCI ################ 
def Check_PTPBVC(Cell_ID,NSEI_VDF_ID,NSEI_TEF_ID)
	ClearMMLBuffer()
    Mail_PTPBVCI = "\n\tPTPBVCI Check:\n"
	Print("\n\tPTPBVCI Check:")
    OK_Count = 0
	for p in Cell_ID
		#LST PTPBVC:IDTYPE=BYID,CELLID=580;
		CMD = ("LST PTPBVC:IDTYPE=BYID,CELLID="+p+";")
		#Print (CMD)
		SendMML(CMD)
		mml = GetMMLReport()
		strCell = ParseMMLRpt(mml)
		dic.update({'Log':str(dic['Log'])+mml})
		
		# If MML command does not execute successfully, the system prompts error and does not continue processing  
		if not strCell or GetResultCode(strCell) != '0' 
			Print('\t    [ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strCell), GetResultCause(strCell))) 
			Mail_PTPBVCI += "\t    [ERROR] FAILED Command Execution "+str(GetMMLCmd(strCell))+"Reason: "+ str(GetResultCause(strCell))
			dic.update({"PTPBVCI Status":"ERROR"})
			return Mail_PTPBVCI
		end
		
		# If MML report has no corresponding entry information, the system prompts error and does not continue processing  
		if GetObjNum(strCell) < 1 
			 Print('\t    [ERROR] No proper entry information found')
			Mail_PTPBVCI += '\t    [ERROR] No proper entry information found\n'
			dic.update({"PTPBVCI Status":"ERROR"})
			return Mail_PTPBVCI 
		end
		
		Cell_name=(GetAttrValueByName(strCell,0,"Cell Name",0))
		if 'T' in Cell_name
			NSEI_len=len(NSEI_TEF_ID)
		else
			NSEI_len=len(NSEI_VDF_ID)
		end
		
		OK_Count_Cell=0
		Num_NSEI = GetRecordNum(strCell,0)
		if NSEI_len == Num_NSEI
			for l in range (Num_NSEI)
				PTPBVCI=(GetAttrValueByName(strCell,0,"PTP BVC Identifier",l))
				Cell_index=(GetAttrValueByName(strCell,0,"Cell Index",l))
				Cell_NSEI=(GetAttrValueByName(strCell,0,"NSE Identifier",l))
				
				if PTPBVCI!=Cell_index			
					if (Cell_index=="0" and PTPBVCI=="65533")
						OK_Count=0
					    OK_Count_Cell=0
					elif (Cell_index=="1" and PTPBVCI=="65534")
						OK_Count=0
						OK_Count_Cell=0
					else
						OK_Count+=1
						OK_Count_Cell+=1
						
					end
				end
			end
		else
			Print("\t    NOK ... Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",0))+" Missing NSEI")
			Mail_PTPBVCI += "\t    NOK ... Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",0))+" Missing NSEI\n"
			OK_Count+=1
		end
		
		if  OK_Count_Cell <= 0
		Print("\t    OK ... Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",0))+" -> Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",0))+" | PTP BVC Identifier = "+str(GetAttrValueByName(strCell,0,"PTP BVC Identifier",0)))
		Mail_PTPBVCI += "\t    OK ... Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",0))+" -> Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",0))+" | PTP BVC Identifier = "+str(GetAttrValueByName(strCell,0,"PTP BVC Identifier",0))+"\n"

	else
		Print("\t    NOK ... Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",0))+" -> Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",0))+" | PTP BVC Identifier = "+str(GetAttrValueByName(strCell,0,"PTP BVC Identifier",0)))
		Mail_PTPBVCI += "\t    NOK ... Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",0))+" -> Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",0))+" | PTP BVC Identifier = "+str(GetAttrValueByName(strCell,0,"PTP BVC Identifier",0))+"\n"

	end   
		
	end	
	if  OK_Count <= 0
		dic.update({"PTPBVCI Status":"OK"})
	else
		dic.update({"PTPBVCI Status":"***** NOT OK *****"})
	end    

return	Mail_PTPBVCI
end


################ Check Admin Cell State ################ 
def Check_CellState(NEname)
    ClearMMLBuffer()
    Mail_Cell = "\n\tCell Administrative State:\n"
	Print("\n\tCell Administrative State:")
    #LST GCELL:IDTYPE=BYNAME,BTSNAME="GSM_SITE_EXAMPLE";
    CMD = ("LST GCELL:IDTYPE=BYNAME,BTSNAME=\""+ NEName+"\";")
    #Print (CMD)
    SendMML(CMD)
    mml = GetMMLReport()
    strCell = ParseMMLRpt(mml)
    dic.update({'Log':str(dic['Log'])+mml})
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strCell or GetResultCode(strCell) != '0' 
        Print('\t    [ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strCell), GetResultCause(strCell))) 
        Mail_Cell += "\t    [ERROR] FAILED Command Execution "+str(GetMMLCmd(strCell))+"Reason: "+ str(GetResultCause(strCell))
		dic.update({"Cells Status":"ERROR"})
		dic.update({"Cells by Operator":"ERROR"})
        return Mail_Cell
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strCell) < 1 
         Print('\t    [ERROR] No proper entry information found')
        Mail_Cell += '\t    [ERROR] No proper entry information found\n'
        dic.update({"Cells Status":"ERROR"})
		dic.update({"Cells by Operator":"ERROR"})
        return Mail_Cell 
    end
    
    # Check Status
	OK_Count = 0
	BVCI_OK_Count = 0
	Cell_ID=[]
	Operator_TEF = 0
	Operator_VF = 0
	#Cell_ID_lock=[]
    Num_Cell = GetRecordNum(strCell,0)
    for l in range (Num_Cell)
        Cell_ID.append(GetAttrValueByName(strCell,0,"Cell Index",l))
		Cell_name=(GetAttrValueByName(strCell,0,"Cell Name",l))
		
		if 'T' in Cell_name
			Operator_TEF += 1
		else
			Operator_VF += 1
		end
		 
        valuestate = GetAttrValueByName(strCell,0,"Administrative State",l)
		valuestate1 = GetAttrValueByName(strCell,0,"active status",l)
        #Print(valuestate)
		if valuestate == "Unlock"
			#Cell_ID_lock.append(GetAttrValueByName(strCell,0,"Cell ID",l))
			if valuestate1 != "ACTIVATED"
				Print("\t    NOK ... Local Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",l))+" -> Admin Sate = "+str(GetAttrValueByName(strCell,0,"Administrative State",l))+" | Status = "+str(GetAttrValueByName(strCell,0,"active status",l)))
				Mail_Cell += "\t    NOK ... Local Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",l))+" -> Admin Sate = "+str(GetAttrValueByName(strCell,0,"Administrative State",l))+" | Status = "+str(GetAttrValueByName(strCell,0,"active status",l))+"\n"
				OK_Count += 1
			else
				Print("\t    OK ... Local Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",l))+" -> Admin Sate = "+str(GetAttrValueByName(strCell,0,"Administrative State",l))+" | Status = "+str(GetAttrValueByName(strCell,0,"active status",l)))
				Mail_Cell += "\t    OK ... Local Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",l))+" -> Admin Sate = "+str(GetAttrValueByName(strCell,0,"Administrative State",l))+" | Status = "+str(GetAttrValueByName(strCell,0,"active status",l))+"\n"
			end
		else
			Print("\t    LCK ... Local Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",l))+" -> Admin Sate = "+str(GetAttrValueByName(strCell,0,"Administrative State",l))+" | Status = "+str(GetAttrValueByName(strCell,0,"active status",l)))
			Mail_Cell += "\t    LCK ... Local Cell Index = "+ str(GetAttrValueByName(strCell,0,"Cell Index",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell Name",l))+" -> Admin Sate = "+str(GetAttrValueByName(strCell,0,"Administrative State",l))+" | Status = "+str(GetAttrValueByName(strCell,0,"active status",l))+"\n"
			OK_Count += 1
		end
    end
    #Print(Cell_ID)
	
	Mail_Cell += "\n\t    Operator_A Cells = "+str(Operator_VF)+" / Operator_B Cells = "+str(Operator_TEF)+"\n"
	dic.update({"Cells by Operator":"Operator_A Cells = "+str(Operator_VF)+" / Operator_B Cells = "+str(Operator_TEF)})
    if  OK_Count <= 0
        dic.update({"Cells Status":"OK"})
    else
        dic.update({"Cells Status":"***** NOT OK *****"})
    end     
	
    return Mail_Cell,Cell_ID
end   

################ Check Actual Cell State ################ 
def Check_ActualCellState(Cell_ID)
    ClearMMLBuffer()
	Mail_ActualCell = "\n\tCell Operational State:\n"
	Print("\n\tCell Operational State:")
	for p in Cell_ID
		#DSP GCELLSTAT:IDTYPE=BYID,CELLIDLST=204;
		CMD = ("DSP GCELLSTAT:IDTYPE=BYID,CELLIDLST="+p+";")
		#Print (CMD)
		SendMML(CMD)
		mml = GetMMLReport()
		strActualCell = ParseMMLRpt(mml)
		dic.update({'Log':str(dic['Log'])+mml})
		
		# If MML command does not execute successfully, the system prompts error and does not continue processing  
		if not strActualCell or GetResultCode(strActualCell) != '0' 
			Print('\t    [ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strActualCell), GetResultCause(strActualCell))) 
			Mail_ActualCell += "\t    [ERROR] FAILED Command Execution "+str(GetMMLCmd(strActualCell))+"Reason: "+ str(GetResultCause(strActualCell))
			dic.update({"Cells Operational Status":"ERROR"})
			return Mail_ActualCell
		end
		
		# If MML report has no corresponding entry information, the system prompts error and does not continue processing  
		if GetObjNum(strActualCell) < 1 
			 Print('\t    [ERROR] No proper entry information found')
			Mail_ActualCell += '\t    [ERROR] No proper entry information found\n'
			dic.update({"Cells Operational Status":"ERROR"})
			return Mail_ActualCell 
		end
		
		# Check Status
		OK_Count = 0


		Cell_Initialized=(GetAttrValueByName(strActualCell,0,"Cell Initialized",0))
		Cell_Service_State=(GetAttrValueByName(strActualCell,0,"Cell Service State",0))
		Blocked_Automatically=(GetAttrValueByName(strActualCell,0,"Blocked Automatically",0))
		Blocked_Manually=(GetAttrValueByName(strActualCell,0,"Blocked Manually",0))
		
		#Print(valuestate)
		if Blocked_Automatically == "No" or Blocked_Manually == "No"
			if Cell_Initialized == "No" or Cell_Service_State == "No"
				Print("\t    NOK ... Local Cell Index = "+ str(GetAttrValueByName(strActualCell,0,"Cell Index",0))+" | Cell Name = "+ str(GetAttrValueByName(strActualCell,0,"Cell Name",0))+" -> Cell Initialized = "+str(Cell_Initialized)+" | Cell Service State = "+str(Cell_Service_State)+" | Blocked_Automatically= "+str(Blocked_Automatically)+" | Blocked_Manually = "+str(Blocked_Manually))
				Mail_ActualCell += "\t    NOK ... Local Cell Index = "+ str(GetAttrValueByName(strActualCell,0,"Cell Index",0))+" | Cell Name = "+ str(GetAttrValueByName(strActualCell,0,"Cell Name",0))+" -> Cell Initialized = "+str(Cell_Initialized)+" | Cell Service State = "+str(Cell_Service_State)+" | Blocked_Automatically= "+str(Blocked_Automatically)+" | Blocked_Manually = "+str(Blocked_Manually)+"\n"
				OK_Count += 1
			else
				Print("\t    OK ... Local Cell Index = "+ str(GetAttrValueByName(strActualCell,0,"Cell Index",0))+" | Cell Name = "+ str(GetAttrValueByName(strActualCell,0,"Cell Name",0))+" -> Cell Initialized = "+str(Cell_Initialized)+" | Cell Service State = "+str(Cell_Service_State)+" | Blocked_Automatically= "+str(Blocked_Automatically)+" | Blocked_Manually = "+str(Blocked_Manually))
				Mail_ActualCell += "\t    OK ... Local Cell Index = "+ str(GetAttrValueByName(strActualCell,0,"Cell Index",0))+" | Cell Name = "+ str(GetAttrValueByName(strActualCell,0,"Cell Name",0))+" -> Cell Initialized = "+str(Cell_Initialized)+" | Cell Service State = "+str(Cell_Service_State)+" | Blocked_Automatically= "+str(Blocked_Automatically)+" | Blocked_Manually = "+str(Blocked_Manually)+"\n"
			end
		else
			Print("\t    LCK ... Local Cell Index = "+ str(GetAttrValueByName(strActualCell,0,"Cell Index",0))+" | Cell Name = "+ str(GetAttrValueByName(strActualCell,0,"Cell Name",0))+" -> Cell Initialized = "+str(Cell_Initialized)+" | Cell Service State = "+str(Cell_Service_State)+" | Blocked_Automatically= "+str(Blocked_Automatically)+" | Blocked_Manually = "+str(Blocked_Manually))
			Mail_ActualCell += "\t    LCK ... Local Cell Index = "+ str(GetAttrValueByName(strActualCell,0,"Cell Index",0))+" | Cell Name = "+ str(GetAttrValueByName(strActualCell,0,"Cell Name",0))+" -> Cell Initialized = "+str(Cell_Initialized)+" | Cell Service State = "+str(Cell_Service_State)+" | Blocked_Automatically= "+str(Blocked_Automatically)+" | Blocked_Manually = "+str(Blocked_Manually)+"\n"
			OK_Count += 1
		end

		
		if  OK_Count <= 0
			dic.update({"Cells Operational Status":"OK"})
		else
			dic.update({"Cells Operational Status":"***** NOT OK *****"})
		end     
	end
	
    return Mail_ActualCell
end   




################ Check Neighbours Relations with UTRAN Cell Intra-Frequency: ################
def Check_NeighboursUTRAN_Intra(Cell_ID)

    Mail_NeighbourUTRAN_Intra = "\n    Intra-Frequency Neighbouring Relation with UTRAN Cell:\n"
    for p in Cell_ID   
        ClearMMLBuffer()        
        CMD = ("LST UINTRAFREQNCELL:CELLID="+p+";")
        #Print (CMD)
        SendMML(CMD)
        #@LST UINTRAFREQNCELL:;
        mml = GetMMLReport()
        strNeighbourUTRAN_Intra = ParseMMLRpt(mml)
    
        # If MML command does not execute successfully, the system prompts error and does not continue processing  
        if not strNeighbourUTRAN_Intra or GetResultCode(strNeighbourUTRAN_Intra) != '0' 
            Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strNeighbourUTRAN_Intra), GetResultCause(strNeighbourUTRAN_Intra))) 
            Mail_NeighbourUTRAN_Intra += "[ERROR] FAILED Command Execution " +str(GetMMLCmd(strNeighbourUTRAN_Intra))+"Reason: "+ str(GetResultCause(strNeighbourUTRAN_Intra))+"\n"
            return Mail_NeighbourUTRAN_Intra 
        end
        
        # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
        if GetObjNum(strNeighbourUTRAN_Intra) < 1 
            Print('[ERROR] No proper entry information found')
            Mail_NeighbourUTRAN_Intra += '[ERROR] No proper entry information found\n'
            return Mail_NeighbourUTRAN_Intra 
        end
        
        # Check Status
        Num_NeighbourUTRAN_Intra = GetRecordNum(strNeighbourUTRAN_Intra,0)
        if Num_NeighbourUTRAN_Intra <= 0
            Print("        NOK ... Intra-Frequency Neighbouring Relation with UTRAN for CellID: "+p+" is "+str(GetRecordNum(strNeighbourUTRAN_Intra,0)))
            Mail_NeighbourUTRAN_Intra += "        NOK ... Intra-Frequency Neighbouring Relation with UTRAN for CellID: "+p+" is "+str(GetRecordNum(strNeighbourUTRAN_Intra,0))+"\n"
        else
            Print("        OK ... Intra-Frequency Neighbouring Relation with UTRAN for CellID: "+p+" is "+str(GetRecordNum(strNeighbourUTRAN_Intra,0)))
            Mail_NeighbourUTRAN_Intra += "        OK ... Intra-Frequency Neighbouring Relation with UTRAN for CellID: "+p+" is "+str(GetRecordNum(strNeighbourUTRAN_Intra,0))+"\n"
        end
    end
    
    return Mail_NeighbourUTRAN_Intra
end

