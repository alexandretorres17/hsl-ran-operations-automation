		OK_Count += 1
        Mail_Alarms_BSC += Mail_Alarms_P
    end
	
	if  OK_Count <= 0
        dic.update({"Active Alarms on BSC":"OK"})
    elif alarm_filter != ""
        dic.update({"Active Alarms on BSC":"***** NOT OK *****"})
	elif alarm_filter == ""
		dic.update({"Active Alarms on BSC":"NOT OK"})
    end 
	
	# if GetAlmRptNum(strAlarmBSC) <= 0
        # Print("OK ... No Active Alarms in %s" %NEName)
