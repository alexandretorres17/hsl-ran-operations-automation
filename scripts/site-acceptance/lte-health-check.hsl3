             if valueSCTP != 'Normal'
                Print("NOK ... S1 Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1 Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1 Interface State",n))+" and S1 CP Bearer State is "+str(GetAttrValueByName(strS1Interface,0,"S1 CP Bearer State",n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n)))
                Mail_S1Interface += "NOK ... S1 Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1 Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1 Interface State",n))+" and S1 CP Bearer State is "+str(GetAttrValueByName(strS1Interface,0,"S1 CP Bearer State",n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n))+"\n"
                OK_Count += 1
            else
                Print("OK ... S1 Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1 Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1 Interface State",n))+" and S1 SCTP Link State is "+str(GetAttrValueByName(strS1Interface,0,"S1 CP Bearer State",n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n)))
                Mail_S1Interface += "OK ... S1 Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1 Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1 Interface State",n))+" and S1 CP Bearer State is "+str(GetAttrValueByName(strS1Interface,0,"S1 CP Bearer State",n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n))+"\n"
            end
        end
        
        cn_value=str(GetAttrValueByIdx(strS1Interface,0,2,n))
        
        if cn_value=='0'
            cn_num+=1
        end
    end
    
    if  OK_Count <= 0
