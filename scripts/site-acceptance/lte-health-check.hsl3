    return Mail_MntMode,Mail_Alarms,Mail_Alarms_Log,Mail_License,Mail_SW,Mail_Cell,Mail_S1Interface,Mail_IPPath,Mail_Neighbour,Mail_VSWR,Mail_Board,Mail_Alarms_After
