################ Main function of the program, responsible for basic logic of the program. ################  
def Main(NEName,Site_name) 
    loginInfo=CreateLoginInfo('192.0.2.10')
    # Send MML commands to NEs and parse messages to obtain the required data 
    Report_Begin_Time = AscTime(LocalTime())
    Mail_MntMode,Mail_Alarms,Mail_Alarms_Log,Mail_License,Mail_SW,Mail_Cell,Mail_S1Interface,Mail_IPPath,Mail_Neighbour,Mail_VSWR,Mail_Board,Mail_Alarms_After = ExecMMLCmd(NEName,Site_name)
    
    
    Print("Overall Status")
    Print("Maintenance Mode = " + str(dic['Maintenance Mode']))
    Print("Active Alarms = " + str(dic['Active Alarms']))
    Print("Licenses = " + str(dic['Licenses']))
    Print("Software Version = " + str(dic['Software Version']))
    Print("Cells Status = " + str(dic['Cells Status']))
    Print("Cells by Operator (Assuming TEF Cell name contains 'T') = " + str(dic['Cells by Operator']))
    Print("S1 Interfaces = " + str(dic['S1 Interfaces']))
    Print("Number VDF MME = " + str(dic['Number VDF MME']))
    Print("S1-U Interface State = " + str(dic['IP Path']))
    Print("Neighbours Relations = " + str(dic['Neighbours Relations']))
    Print("VSWR = " + str(dic['VSWR']))
    Print("PIM Test = " + str(dic['PIM Test']))
    Print("Alarms Log = " + str(dic['Alarms Log']))
    Print("Alarms Log from the Last 10 Days = " + str(dic['Alarms Log_10days']))
    Print("Active Alarms After Tests = " + str(dic['Active Alarms After Tests']))
    
    
    if NEName != Site_name
        Overall = "\nOverall Status for site "+NEName+" Co-MPT Site "+str(Site_name)+"\n\n"
    else
        Overall = "\nOverall Status for site "+NEName+"\n\n"
    end
    Overall += "\tMaintenance Mode = " + str(dic['Maintenance Mode']) + "\n\tActive Alarms = " + str(dic['Active Alarms']) + "\n\tLicenses = " + str(dic['Licenses']) + "\n\tSoftware Version = " + str(dic['Software Version']) + "\n\tCells Status = " + str(dic['Cells Status']) + "\n\tCells by Operator (Assuming TEF Cell name contains 'T') = " + str(dic['Cells by Operator'])+ "\n\tS1 Interfaces =  "+ str(dic['S1 Interfaces']) +  "\n\tNumber VDF MME =  " + str(dic['Number VDF MME']) + "\n\tS1-U Interface State =  "+ str(dic['IP Path'])+ "\n\tNeighbours Relations = " + str(dic['Neighbours Relations']) + "\n\tVSWR = " + str(dic['VSWR'])+ "\n\tPIM Test = " + str(dic['PIM Test']) + "\n\tAlarms Log = " + str(dic['Alarms Log']) + "\n\tAlarms Log from Last 10 Days = " + str(dic['Alarms Log_10days']) + "\n\tActive Alarms After Tests = " + str(dic['Active Alarms After Tests'])
    Report_End_Time_1 = AscTime(LocalTime())
    Overall += "\n\n"+str(NEName) +"\t" + str(dic['Maintenance Mode']) + "\t" + str(dic['Active Alarms']) + "\t" + str(dic['Licenses']) + "\t" + str(dic['SW_Version']) + "\t" + str(dic['Cells Status']) + "\t" + str(dic['Cells by Operator']) + "\t" + str(dic['S1 Interfaces']) + "\t" + str(dic['Number VDF MME']) + "\t" + str(dic['IP Path']) + "\t" + str(dic['Neighbours Relations']) + "\t" + str(dic['VSWR']) + "\t" + str(dic['PIM Test']) + "\t" + str(Report_End_Time_1)
    
    
    
    #--------------
    Report_End_Time = AscTime(LocalTime())
    Data_4GHC = "\n***** LTE ACCEPTANCE REPORT ***** \n\nVF Site Ref: "+NEName+"\nExecution Begin Date: "+ Report_Begin_Time+"\n\n"
    Data_4GHC += (str(Mail_MntMode)+str(Mail_Alarms)+str(Mail_License)+str(Mail_SW)+str(Mail_Cell)+str(Mail_S1Interface)+str(Mail_IPPath)+str(Mail_Neighbour)+str(Mail_VSWR)+str(Mail_Board)+str(Mail_Alarms_After))
    Data_4GHC += "\n\nExecution End Date: "+ Report_End_Time+"\n"+"\n*****  END OF REPORT  *****"
    Path = "/export/ossuser/.Acceptance_Logs/4G_"+NEName+".txt"
	file_open = Open(Path,'w')
    file_open.write(Data_4GHC)
    file_open.close()
    Path_Log = "/export/ossuser/.Acceptance_Logs/4G_"+NEName+"_LOG.txt"
    Info_Log = str(dic['Log'])
    Log_Info=str(Info_Log)
    log_open = Open(Path_Log,'w')
    log_open.write(Log_Info)
    log_open.close()
    
    All_Path = []
    All_Path.append(Path)
    All_Path.append(Path_Log)
    
    #Print(Data_4GHC)
    #Print("Sending Email........")
    mailInfo = CreateMailInfo()
    #mailInfo['TO_ADDR']=("portfolio@example.invalid","portfolio@example.invalid","portfolio@example.invalid")
    mailInfo['TO_ADDR'] = mail
    #mailInfo['CC_ADDR']=("portfolio@example.invalid")
    mailInfo['FROM_ADDR']='portfolio@example.invalid'
    mailInfo['MAIL_SUBJECT']='LTE Health Check '+str(NEName)
    mailInfo['MAIL_BODY']= str(Overall)
    mailInfo['MAIL_ATTACH'] = All_Path

    result=SendMail(mailInfo)
    Print(result)
    
    #Removes File
    
    #Sleep(10)
    
   
end

