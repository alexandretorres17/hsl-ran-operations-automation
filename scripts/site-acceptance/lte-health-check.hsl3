################ Get list with full name of the NE ################
def Get_ElementList(ElementListfull,Element)
    
    # NE_List=GetNELstByType("BTS3900L LTE")    #BTS3900L LTE & BTS3900AL LTE
    
    Element_LTE=[]

    for i in ElementListfull
        if Element in i
            #Print (i)
            Element_LTE.append(i)
        end
    end
    #Print(Element_LTE)
    
    
    return Element_LTE
end



################ Get list with full name of the NE ################
def Get_ElementListfull()
    
    # NE_List=GetNELstByType("BTS3900L LTE")    #BTS3900L LTE & BTS3900AL LTE
    NE_List=GetNELst()

    Element_List=[]
    for j in NE_List
        if 'V' in j
            #Print (j)
            Element_List.append(j)
        end
    end
    #Print(Element_List)
    return Element_List
end



####################################--Function definition-end--####################################

####################################--Program execution-begin--####################################
##GET SRAN LIST
neListall = GetNELst()
#Print(neListall)
Element_CoMPT=[]
ElementListfull=Get_ElementListfull()
for j in neListall
        if 'SRAN' in j
            #Print (j)
            Element_CoMPT.append(j)
        end
end
# Print(Element_CoMPT)

for Element in NE_Name
    Site_name=Element
    Site_name2 = []
    Element_LTE = Get_ElementList(ElementListfull,Element)
    Print(str(Element))
    Print (str(Element_LTE))
        if Element_LTE == []
            suck=ConnectNE(Site_name)
            ## fazer mml 4G
            if suck != 1
                ## if se ok quer dizer que o site name é igual ao elemte_LTE se não correr a verificação SRAN e por o site_name = ao element
                NE_Num =  ''.join([j for j in Element if j.isdigit()]) 
                NE_Num = NE_Num[-5:]
                ##Print(str(Element)+"-"+str(NE_Num))
                for k in Element_CoMPT
                   if NE_Num in k
                       #Print (k)
                       Site_name2.append(k)
                    end
                end
                Print(Site_name2)
                            
                for site in Site_name2
                    xpto=ConnectNE(site)
                    # Sleep(2)
                
                    ClearMMLBuffer()
                    xpto=SendMML("LST ENODEBFUNCTION:;")
                    Print(str(xpto))
                    mml = GetMMLReport()
                    strnode = ParseMMLRpt(mml)
                    value_node = GetAttrValueByName(strnode,0,"eNodeB Function Name",0)
                    
                    Print("dentro="+str(value_node))
                    Print("dentro="+str(Site_name))
                    if str(value_node) == str(Site_name)
                        Site_name=site
                    end            
                end
                
                if str(Site_name) == str(Element)
                    Site_name=[]
                end        
                
                Element_LTE = [Element]
            end
            
        end

    for NEName in Element_LTE
        Print(NEName)
        Print(Site_name)
        if Site_name != [] and NE_Name != []
            Main(NEName,Site_name)
        end
    end
    
end

