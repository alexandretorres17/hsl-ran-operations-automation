################ Check Neighbours Relations: ################
def Check_Neighbours()

    Mail_Neighbour = "\n    Neighbour Relation Check:\n"
    Intra,Info_Intra,OK_Intra = Check_NeighboursEUTRAN_Intra()
    Inter,Info_Inter,OK_Inter = Check_NeighboursEUTRAN_Inter()
    N3G,Info_N3G,OK_N3G = Check_NeighboursUTRAN()
    N2G,Info_N2G,OK_N2G = Check_NeighboursGERAN()
    Mail_Neighbour += str(Intra)+str(Inter)+str(N3G)+str(N2G)
    
    Info_log = Info_Intra + Info_Inter + Info_N3G + Info_N2G 
    OK_Count = OK_Intra + OK_Inter + OK_N3G + OK_N2G 
    
    if  OK_Count <= 0
        dic.update({"Neighbours Relations":"OK"})
    elif OK_Inter > 0
        dic.update({"Neighbours Relations":"OK (LTE Inter)"})
    else
        dic.update({"Neighbours Relations":"***** NOT OK *****"})
    end   
    
    return Mail_Neighbour,Info_log
end

################ Check S1-U Interface State ################ 
def Check_IP(IPPath)

    ClearMMLBuffer()
    Mail_IP = ""
    CMD = ("DSP IPPATH:PATHID="+str(IPPath)+";")
    #Print (CMD)
    SendMML(CMD)
    #@STR RFTEST:TSTTYPE=PIMOFFLINE,CN=0,SRN=5,SN=2;
    mml = GetMMLReport(-1)
    #Print(mml)
    strIP = ParseMMLRpt(mml)
    Info_log = str(mml)
    OK_Count = 1
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strIP or GetResultCode(strIP) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strIP), GetResultCause(strIP)) ) 
        Mail_IP += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strIP))+"Reason: "+ str(GetResultCause(strIP))
        return Mail_IP,Info_log
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strIP) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_IP += '[ERROR] No proper entry information found\n'      
        return Mail_IP,Info_log
    end
    
    # Check Status  
    OK_Count = 0
    value_IP = GetAttrValueByName(strIP,0,"IP Path Check Result",0)
    if value_IP == 'Normal'
        Print("OK ... IP Path ID "+str(IPPath)+": IP Path Check is "+str(GetAttrValueByName(strIP,0,"IP Path Check Result",0)))
        Mail_IP += "OK ... IP Path ID "+str(IPPath)+": IP Path Check is "+str(GetAttrValueByName(strIP,0,"IP Path Check Result",0))
    else
        Print("NOK ... IP Path ID "+str(IPPath)+": Not possible to check due to "+str(GetAttrValueByName(strIP,0,"IP Path Check Result",0)))
        Mail_IP += "NOK ... IP Path ID "+str(IPPath)+": Not possible to check due to "+str(GetAttrValueByName(strIP,0,"IP Path Check Result",0))
        OK_Count += 1
    end

    
    
    
    return Mail_IP,Info_log,OK_Count
end

################ Check S1-U Interface State (IPPath) ################ 
def Check_IPPath()

    ClearMMLBuffer()
    Mail_IPPath = "\n    S1-U interface state\n"
    @LST CNOPERATORIPPATH:;
    mml = GetMMLReport()
    strIPPath = ParseMMLRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strIPPath or GetResultCode(strIPPath) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strIPPath), GetResultCause(strIPPath))) 
        Mail_IPPath += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strIPPath))+"Reason: "+ str(GetResultCause(strIPPath))
        dic.update({"IP Path":"ERROR"})
        return Mail_IPPath,Info_log
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strIPPath) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_IPPath += '[ERROR] No proper entry information found\n'
        dic.update({"IP Path":"ERROR"})
        return Mail_IPPath,Info_log 
    end
    
    # Check Status
    Num_IPPath = GetRecordNum(strIPPath,0)   
    OK_Count = 0
    for o in range (Num_IPPath)
        IPPath = str(GetAttrValueByIdx(strIPPath,0,0,o)) #IP Path ID
        Mail_IP,Info_IP,OK_IP = Check_IP(IPPath)
        Mail_IPPath += Mail_IP+"\n"
        OK_Count += int(OK_IP)
        Info_log += str(Info_IP)
    end
    
    if  OK_Count <= 0
        dic.update({"IP Path":"OK"})
    else
        dic.update({"IP Path":"NOT OK"})
    end 
    
    return Mail_IPPath,Info_log
end   




################ Check Active Alarms After Tests ################
def Check_Alarms_After(NEName)

    ClearMMLBuffer()
    Mail_Alarms = "\n    Active Alarms After Tests:\n"
    @LST ALMAF:;
    mml = GetMMLReport()
    strAlarm = ParseAlmRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strAlarm or GetAlmResultCode(strAlarm) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetAlmMMLCmd(strAlarm), GetAlmResultCause(strAlarm)) ) 
        Mail_Alarms += "[ERROR] FAILED Command Execution "+str(GetAlmMMLCmd(strAlarm))+"Reason: "+ str(GetAlmResultCause(strAlarm))+"\n"
        dic.update({'Active Alarms After Tests':'ERROR'})
        return Mail_Alarms,Info_log
    end
    
    OK_Count = 0 
    if GetAlmRptNum(strAlarm) <= 0
        Print("OK ... No Active Alarms After Tests in %s" %NEName)
        Mail_Alarms += ("OK ... No Active Alarms After Tests in %s" %NEName)+"\n"
    else   
        Print("NOK ... ACTIVE ALARMS After Tests in %s" %NEName)
        Mail_Alarms += ("NOK ... ACTIVE ALARMS After Tests in %s" %NEName)+"\n"
		alarm_print, alarm_filter = Print_Alarms(strAlarm)
        Mail_Alarms += alarm_print
        OK_Count += 1
    end
    
    if  OK_Count <= 0
        dic.update({"Active Alarms After Tests":"OK"})
	elif alarm_filter != "" 
        dic.update({"Active Alarms After Tests":"***** NOT OK *****"})
    elif alarm_filter == ""
        dic.update({"Active Alarms After Tests":"NOT OK"})
    end    
    
    return Mail_Alarms,Info_log
end






def ExecMMLCmd(NEName,Site_name)
    # Send MML command to NE to obtain messages. Being restricted by the running environment, we use constant instead.      
    if NEName != Site_name
        ConnectNE(Site_name)
    else
        ConnectNE(NEName)
    end
    Sleep(3)
    
    ################ Check Maintenance Mode 
    Mail_MntMode,Info_Log_MntMode = Check_MmtMode()  
    # Mail_MntMode="\nCheck Maintenance Mode - Function Commented\n" 
    # Info_Log_MntMode ="\nCheck Maintenance Mode - Function Commented\n"
    # dic.update({'Maintenance Mode':'Function Commented'})
    
    ################ Check if there are active Alarms
    Mail_Alarms,Info_Log_Alarms = Check_Alarms(NEName)   
    # Mail_Alarms="\nCheck Active Alarms - Function Commented\n" 
    # Info_Log_Alarms ="\nCheck Active Alarms - Function Commented\n"
    # dic.update({'Active Alarms':'Function Commented'})
    
    ################ Check Alarms Log
    Mail_Alarms_Log,Info_Log_Alarms_Log = Check_Alarms_Log(NEName)   
    # Mail_Alarms_Log="\nCheck Active Alarms - Function Commented\n" 
    # dic.update({'Alarms Log':'Function Commented'})
    # dic.update({'Alarms Log_10days':'Function Commented'})
    # Info_Log_Alarms_Log ="\nCheck Alarms Log - Function Commented\n"
    
    ################ Check Software Version
    Mail_SW,Info_Log_SW = Check_SW()
    # Mail_SW="\nCheck Software Version - Function Commented\n"  
    # Info_Log_SW ="\nCheck Software Version  - Function Commented\n"
    # dic.update({'Software Version':'Function Commented'})
    
    
    if "R010" in str(dic['SW_Version'])
        ################ Check Licenses SRAN10
        Mail_License,Info_Log_License = Check_Licenses_SRAN10() 
        # Mail_License="\nCheck Licenses - Function Commented\n" 
        # Info_Log_License ="\nCheck Licenses  - Function Commented\n"
        # dic.update({'Licenses':'Function Commented'})
        
            ################ Check S1 Interfaces SRAN9
            Mail_S1Interface,Info_Log_S1Interface = Check_S1Interfaces_SRAN9()
            # Mail_S1Interface="\nCheck S1 Interfaces - Function Commented\n"    
