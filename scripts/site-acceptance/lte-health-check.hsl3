whitelist_alarm_info = ["Conflict Type=Confusion", "HIGH TEMP","X2 Interface Fault","X2 Interface Reset","Service Type=X2-AP","Backup Power Saving","Battery Current Out of Range","Extend Alarm","NE Software Download Ended","NE Software Download Started","Delta Urgent Alarm","NE Software Activation Ended","NE Software Activation Started","INTRUDER I R","INTRUDER DOOR","MAINS FAIL","Delta Non Urgent Alarm","maximum number of X2 interfaces","Mains Input Out of Range","Delta Mains Fail"]

NE_Name = ["LTE_SITE_EXAMPLE"]


