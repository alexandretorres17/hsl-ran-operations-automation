    end
    
    # Check Status
    Num_S1Interface = GetRecordNum(strS1Interface,0)  
    OK_Count = 0   
    cn_num=0
    for n in range (Num_S1Interface)
        valueS1 = GetAttrValueByName(strS1Interface,0,"S1Interface state",n)
        #Print(valuestate)
        if valueS1 != 'Normal'
            Print("NOK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1Interface state",n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n)))
            Mail_S1Interface += "NOK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1Interface state",n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n))+"\n"        
            OK_Count += 1
        else
            valueSCTP = GetAttrValueByIdx(strS1Interface,0,6,n)
             if valueSCTP != 'Normal'
                Print("NOK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1Interface state",n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n)))
                Mail_S1Interface += "NOK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1Interface state",n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n))+"\n"
                OK_Count += 1
            else
                Print("OK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1Interface state",n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n)))
                Mail_S1Interface += "OK ... S1Interface ID "+ str(GetAttrValueByName(strS1Interface,0,"S1Interface ID",n))+" is "+str(GetAttrValueByName(strS1Interface,0,"S1Interface state",n))+" and S1 SCTP Link State is "+str(GetAttrValueByIdx(strS1Interface,0,6,n))+" and the CN Operator ID is "+str(GetAttrValueByIdx(strS1Interface,0,2,n))+"\n"
            end
        end
        
        cn_value=str(GetAttrValueByIdx(strS1Interface,0,2,n))
        
        if cn_value=='0'
            cn_num+=1
        end
    end
    
    if  OK_Count <= 0
        dic.update({"S1 Interfaces":"OK"})
    else
        dic.update({"S1 Interfaces":"***** NOT OK *****"})
    end 
    
    if  cn_num >= 5
        dic.update({"Number VDF MME":"OK"})
    else
        dic.update({"Number VDF MME":"***** NOT OK *****"})
    end 
    
    return Mail_S1Interface,Info_log
end





################ Check S1 Interfaces ################
def Check_S1Interfaces_SRAN9()
    
    ClearMMLBuffer()
    Mail_S1Interface = "\n    S1-MME interface state:\n"
    @DSP S1INTERFACE:;
    mml = GetMMLReport()
    strS1Interface = ParseMMLRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strS1Interface or GetResultCode(strS1Interface) != '0' 
        Print('[ERROR]  FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strS1Interface), GetResultCause(strS1Interface))) 
        Mail_S1Interface += "[ERROR]  FAILED Command Execution "+str(GetMMLCmd(strS1Interface))+"Reason: "+ str(GetResultCause(strS1Interface))+"\n"
        dic.update({"S1 Interfaces":"ERROR"})
        return Mail_S1Interface,Info_log
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
