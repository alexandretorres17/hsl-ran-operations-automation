################ Main function of the program, responsible for basic logic of the program. ################  
def Main(RNCName,NEName,Site_name) 
	loginInfo=CreateLoginInfo('192.0.2.10')
    # Send MML commands to NEs and parse messages to obtain the required data 
    Report_Begin_Time = AscTime(LocalTime()) 
    Mail_MntMode,Mail_Alarms,Mail_Alarms_Log,Mail_License,Mail_SW,Mail_Cell,Mail_Neighbour,Mail_VSWR,Mail_Alarms_RNC,Info_Log,Mail_Alarms_After,Mail_Alarms_RNC_After,Mail_ADJNode= ExecMMLCmd(RNCName,NEName,Site_name)
    fdn = GetNEFDN(NEName)

    

	Print("FDN: " + fdn)
    Print("Maintenance Mode = " + str(dic['Maintenance Mode']))
    Print("Active Alarms = " + str(dic['Active Alarms']))
    Print("Licenses = " + str(dic['Licenses']))
    Print("Software Version = " + str(dic['Software Version']))
    Print("VSWR = " + str(dic['VSWR']))
    Print("Cells Status = " + str(dic['Cells Status']))
	Print("Cells by Operator (Assuming TEF Cell name contains 'T')= " + str(dic['Cells by Operator']))
	Print("ADJNode = " + str(dic['ADJNode Status']))
	Print("Active Alarms on RNC = " + str(dic['Active Alarms on RNC']))
    Print("Neighbours Relations = " + str(dic['Neighbours Relations']))
    Print("Alarms Log = " + str(dic['Alarms Log']))
    Print("Alarms Log from the Last 10 Days = " + str(dic['Alarms Log_10days']))
	Print("Active Alarms After Tests = " + str(dic['Active Alarms After Tests']))
	Print("Active Alarms on RNC After Tests = " + str(dic['Active Alarms on RNC After Tests']))

    if NEName != Site_name
		Overall = "\nOverall Status for site "+NEName+" Co-MPT Site "+Site_name+"\n\n"
	else
		Overall = "\nOverall Status for site "+NEName+"\n\n"
	end 
    Overall += "\tMaintenance Mode = " + str(dic['Maintenance Mode']) + "\n\tActive Alarms = " + str(dic['Active Alarms']) + "\n\tLicenses = " + str(dic['Licenses']) + "\n\tSoftware Version = " + str(dic['Software Version']) + "\n\tCells Status = " + str(dic['Cells Status']) + "\n\tCells by Operator (Assuming TEF Cell name contains 'T') = " + str(dic['Cells by Operator']) + "\n\tADJNode = " + str(dic['ADJNode Status']) + "\n\tActive Alarms on RNC = " + str(dic['Active Alarms on RNC']) + "\n\tNeighbours Relations = " + str(dic['Neighbours Relations']) + "\n\tVSWR = " + str(dic['VSWR']) + "\n\tAlarms Log = " + str(dic['Alarms Log']) + "\n\tAlarms Log from Last 10 Days = " + str(dic['Alarms Log_10days']) + "\n\tActive Alarms After Tests = " + str(dic['Active Alarms After Tests']) + "\n\tActive Alarms on RNC After Tests = " + str(dic['Active Alarms on RNC After Tests'])
    Report_End_Time_1 = AscTime(LocalTime())
    #Overall += "\n\n"+str(NEName) +"\t" + str(dic['Maintenance Mode']) + "\t" + str(dic['Active Alarms']) + "\t" + str(dic['Licenses']) + "\t" + str(dic['SW_Version']) + "\t" + str(dic['Cells Status']) + "\t" + str(dic['Cells by Operator']) + "\t" + str(dic['Active Alarms on RNC']) + "\t" + str(dic['Neighbours Relations']) + "\t" + str(dic['VSWR']) + "\t" + str(Report_End_Time_1) 
    
    #--------------
    Report_End_Time = AscTime(LocalTime())
    Data_3GHC = "\n***** UMTS ACCEPTANCE REPORT ***** \n\nVF Site Ref: "+NEName+"\nFDN: "+fdn+"\nRNC Ref: "+RNCName+"\nExecution Begin Date: "+ Report_Begin_Time+"\n\n"
    Data_3GHC += (str(Mail_MntMode)+str(Mail_Alarms)+str(Mail_Alarms_Log)+str(Mail_Alarms_RNC)+str(Mail_License)+str(Mail_SW)+str(Mail_Cell)+str(Mail_Neighbour)+str(Mail_VSWR)+str(Mail_ADJNode)+str(Mail_Alarms_After)+str(Mail_Alarms_RNC_After))
    Data_3GHC += "\n\nExecution End Date: "+ Report_End_Time+"\n"+"\n*****  END OF REPORT  *****"
    
    
    #Print(Data_3GHC)
	Path = "/export/ossuser/.Acceptance_Logs/3G_"+NEName+".txt"
    file_open = Open(Path,'w')
    file_open.write(Data_3GHC)
	file_open.close()
    Path_Log = "/export/ossuser/.Acceptance_Logs/3G_"+NEName+"_LOG.txt"
    Log_Info=str(Info_Log)
    log_open = Open(Path_Log,'w')
    log_open.write(Log_Info)
    log_open.close()
    
    return Path,Path_Log,Overall
    #Sleep(10)
end

################ Send Mail ################
def Send_Mail(Path,NEName_Group,Overall_Status)

    Print("Sending Email........")
    mailInfo = CreateMailInfo()
    mailInfo['TO_ADDR'] = mail
    #mailInfo['CC_ADDR']=("portfolio@example.invalid")
    #mailInfo['TO_ADDR']=("portfolio@example.invalid","portfolio@example.invalid")
    mailInfo['FROM_ADDR'] ='portfolio@example.invalid'
    mailInfo['MAIL_SUBJECT'] ='UMTS Health Check '+str(NEName_Group)
    mailInfo['MAIL_BODY'] = str(Overall_Status)

    mailInfo['MAIL_ATTACH'] = Path
    
    result=SendMail(mailInfo)
    Print(result)
    
    #Removes Files
    i=0
    #for i in range(len(Path))
     #   rm_path=Path[i]
     #   Remove(rm_path)
    #end
    
end


################ Check Maintenance Mode ################
def Check_MmtMode()

    ClearMMLBuffer()
    Mail_MntMode = "\n    Maintenance Mode Check:\n"
    @DSP MNTMODE:;
    mml = GetMMLReport()
    strMntMode = ParseMMLRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strMntMode or GetResultCode(strMntMode) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strMntMode), GetResultCause(strMntMode)) ) 
        Mail_MntMode += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strMntMode))+"Reason: "+ str(GetResultCause(strMntMode))+"\n"
        dic.update({'Maintenance Mode':'ERROR'})
        return Mail_MntMode,Info_log
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strMntMode) < 1 
        Print("[ERROR] No proper entry information found")
        Mail_MntMode += '[ERROR] No proper entry information found\n'
        dic.update({'Maintenance Mode':'ERROR'})
        return Mail_MntMode,Info_log
    end
    
    # Check Status
    Num_MntMode = GetRecordNum(strMntMode,0)
    valueMntMode = GetAttrValueByIdx(strMntMode,0,0,0)
   OK_Count=0
    if valueMntMode != 'NORMAL'
        Print("NOK ... Current Maintenance Mode is %s" %valueMntMode)
        Mail_MntMode += "NOK ... Current Maintenance Mode is %s" %valueMntMode
        OK_Count += 1
    else
        Print("OK ... Current Maintenance Mode is set to %s" %valueMntMode)
        Mail_MntMode += ("OK ... Current Maintenance Mode is set to %s" %valueMntMode)+"\n"
    end
    
   
    if  OK_Count <= 0
        dic.update({'Maintenance Mode':'OK'})
    else
        dic.update({'Maintenance Mode':'***** NOT OK *****'})
   end
   
   return Mail_MntMode,Info_log

end

################ Check Active Alarms ################
def Check_Alarms(NEName)

    ClearMMLBuffer()
    Mail_Alarms = "\n    Active Alarms Check:\n"
    @LST ALMAF:;
    mml = GetMMLReport()
    strAlarm = ParseAlmRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strAlarm or GetAlmResultCode(strAlarm) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetAlmMMLCmd(strAlarm), GetAlmResultCause(strAlarm)) ) 
        Mail_Alarms += "[ERROR] FAILED Command Execution "+str(GetAlmMMLCmd(strAlarm))+"Reason: "+ str(GetAlmResultCause(strAlarm))+"\n"
        dic.update({'Active Alarms':'ERROR'})
        return Mail_Alarms,Info_log
    end
    
    OK_Count = 0        
    if GetAlmRptNum(strAlarm) <= 0
        Print("OK ... No Active Alarms in %s" %NEName)
        Mail_Alarms += ("OK ... No Active Alarms in %s" %NEName)+"\n"
    else   
        Print("NOK ... ACTIVE ALARMS in %s" %NEName)
        Mail_Alarms += ("NOK ... ACTIVE ALARMS in %s" %NEName)+"\n"
		alarms_print, alarm_filter = Print_Alarms(strAlarm)
        Mail_Alarms += alarms_print
        OK_Count += 1
    end
    
    if  OK_Count <= 0
        dic.update({"Active Alarms":"OK"})
    elif alarm_filter != ""
        dic.update({"Active Alarms":"***** NOT OK *****"})
	elif alarm_filter == ""
		dic.update({"Active Alarms":"NOT OK"})
    end    
    
    return Mail_Alarms,Info_log
end

################ Print Active Alarms ################
def Print_Alarms(Alarms_Parse)
   
    Alarms_Parse
    Mail_Alarms_Print="    Site Has the Following Active Alarms:\n"
	Alarm_filter = ""
    for p in range(GetAlmRptNum(Alarms_Parse))
        Print("          "+str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p)))
        Mail_Alarms_Print += "          "+ str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+"\n"
		
		for whitlist in whitelist_alarm_info
			if (whitlist in str(GetAlmLocationInfo(Alarms_Parse,p))) or whitlist in (str(GetAlmName(Alarms_Parse,p)))
				break
			else
				continue
			end
		else
			# Print ("teste: " + str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+" - "+str(GetAlmLocationInfo(Alarms_Parse,p))+"\n")
			Alarm_filter += str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+" - "+str(GetAlmLocationInfo(Alarms_Parse,p))+"\n"
		end
    end
   
    return Mail_Alarms_Print, Alarm_filter
end





################ Check Alarms Log ################
def Check_Alarms_Log(NEName)

    ClearMMLBuffer()
    Mail_Alarms_Log = "\n    Alarms Log Check:\n"
	@LST ALMLOG:ALMTP=ALL;
	#@LST ALMLOG:ALMTP=ALL,SD=2014&08&22;
    mml = GetMMLReport()
    strAlarm_Log = ParseAlmRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strAlarm_Log or GetAlmResultCode(strAlarm_Log) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetAlmMMLCmd(strAlarm_Log), GetAlmResultCause(strAlarm_Log)) ) 
        Mail_Alarms_Log += "[ERROR] FAILED Command Execution "+str(GetAlmMMLCmd(strAlarm_Log))+"Reason: "+ str(GetAlmResultCause(strAlarm_Log))+"\n"
        dic.update({'Alarms Log':'ERROR'})
        return Mail_Alarms_Log,Info_log
    end
    
    
    if GetAlmRptNum(strAlarm_Log) <= 0
        Print("OK ... No Alarm Log in %s" %NEName)
        Mail_Alarms_Log += ("OK ... No Alarm Log in %s" %NEName)+"\n"
    else   
        Print("NOK ... Alarm Log in %s" %NEName)
        Mail_Alarms_Log += ("NOK ... Alarm Log in %s" %NEName)+"\n"
		print_alarm_log, alarm_log_filter = Print_Alarms_Log(strAlarm_Log)
        Mail_Alarms_Log += print_alarm_log
		Mail_Alarms_Log_10days, Info_log_10days = Check_Alarms_Log_10days(NEName)
        Mail_Alarms_Log += str(Mail_Alarms_Log_10days)
		Info_log += str(Info_log_10days)
    end
  
    
    return Mail_Alarms_Log,Info_log
end

################ Print Alarms Log ################ 
def Print_Alarms_Log(Alarms_Parse)
   
    Alarms_Parse
    Mail_Alarms_Log_Print="    Site Had the Following Alarms Log:\n"
    log_dic.clear()
	Alarm_log_filter = ""
    for p in range(GetAlmRptNum(Alarms_Parse))
        Print("          "+str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p)))
        Mail_Alarms_Log_Print += "          "+ str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+"\n"
		
		for whitlist in whitelist_alarm_info
			if (whitlist in str(GetAlmLocationInfo(Alarms_Parse,p))) or whitlist in (str(GetAlmName(Alarms_Parse,p)))
				break
			else
				continue
			end
		else
			#Print ("teste: " + str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+" - "+str(GetAlmLocationInfo(Alarms_Parse,p))+"\n")
			Alarm_log_filter += str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+" - "+str(GetAlmLocationInfo(Alarms_Parse,p))+"\n"

		end
    end
   
    return Mail_Alarms_Log_Print, Alarm_log_filter
end

################ Check Alarms Log ################
def Check_Alarms_Log_10days(NEName)

    ClearMMLBuffer()
    Mail_Alarms_Log_10days = "\n    Alarms Log 10 Days Check:\n"
    
    #Get the GMT time.
    secs = Time()
    #Output the GMT time.
    #Add 3600 S, that is, one hour, to secs. Subtract 864000 (10 days) Then, output the result.
	time_ref = StrfTime("%Y-%m-%d %H:%M:%S", GMTime(secs + 3600-864000))
    #Print(time_ref)
    year=time_ref[0:4]
    month=time_ref[5:7]
    day=time_ref[8:10]
	
	
	#@LST ALMLOG:ALMTP=ALL,SD=2014&08&22;
    CMD = ("LST ALMLOG:ALMTP=ALL,SD="+year+"&"+month+"&"+day+";")
    #Print (CMD)
    SendMML(CMD)

    mml = GetMMLReport()
    strAlarm_Log_10days = ParseAlmRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strAlarm_Log_10days or GetAlmResultCode(strAlarm_Log_10days) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetAlmMMLCmd(strAlarm_Log_10days), GetAlmResultCause(strAlarm_Log_10days)) ) 
        Mail_Alarms_Log_10days += "[ERROR] FAILED Command Execution "+str(GetAlmMMLCmd(strAlarm_Log_10days))+"Reason: "+ str(GetAlmResultCause(strAlarm_Log_10days))+"\n"
        dic.update({'Alarms Log':'ERROR'})
        dic.update({"Alarms Log_10days":'ERROR'})
        return Mail_Alarms_Log_10days,Info_log
    end
    
    OK_Count = 0        
    if GetAlmRptNum(strAlarm_Log_10days) <= 0
        Print("OK ... No Alarm Log from Last 10 Days in %s" %NEName)
        Mail_Alarms_Log_10days+= ("OK ... No Alarm Log from Last 10 Days in %s" %NEName)+"\n"
    else   
        Print("NOK ... Alarm Log from Last 10 Days in %s" %NEName)
        Mail_Alarms_Log_10days += ("NOK ... Alarm Log from Last 10 Days in %s" %NEName)+"\n"
		log_print, limit_check, log_print_filter = Print_Alarms_Log_10days(strAlarm_Log_10days)
        Mail_Alarms_Log_10days += log_print
		
        OK_Count += 1
    end
    #Print(str(log_dic['SCTP Link Congestion']))
    #Print(str(log_dic.items()))
   
    if  OK_Count <= 0
        dic.update({"Alarms Log":"OK"})
    elif limit_check == "notok" and log_print_filter != ""
        dic.update({"Alarms Log":"***** NOT OK *****"})
	else
        dic.update({"Alarms Log":"NOT OK"}) ## Sem as * quer dizer que tem log mas nenhum alarme com mais de 3x então a macro do excel vai ignorar
    end    
    
    dic.update({"Alarms Log_10days":""+ str(log_dic.items())})
    return Mail_Alarms_Log_10days,Info_log
end

################ Print Alarms Log ################
def Print_Alarms_Log_10days(Alarms_Parse)
   
    Alarms_Parse
    Mail_Alarms_Log_Print_10days="    Site Had the Following Alarms Log in the Last 10 Days:\n"
    log_dic.clear()
	Alarm_log_filter = ""
	limit_error = ""
    for p in range(GetAlmRptNum(Alarms_Parse))
        Print("          "+str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p)))
        Mail_Alarms_Log_Print_10days += "          "+ str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+"\n"
       
        for whitlist in whitelist_alarm_info
			if (whitlist in str(GetAlmLocationInfo(Alarms_Parse,p))) or whitlist in (str(GetAlmName(Alarms_Parse,p)))
				break
			else
				continue
			end
		else
			if str(GetAlmName(Alarms_Parse,p))not in log_dic
				log_dic.update({str(GetAlmName(Alarms_Parse,p)):1})
			else
				log_dic.update({str(GetAlmName(Alarms_Parse,p)):int(log_dic[str(GetAlmName(Alarms_Parse,p))])+1})
				if (log_dic[str(GetAlmName(Alarms_Parse,p))] >= 5)
					limit_error = "notok"
				end
			end
			Alarm_log_filter += str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+" - "+str(GetAlmLocationInfo(Alarms_Parse,p))+"\n"
		end
    end
   
    return Mail_Alarms_Log_Print_10days, limit_error, Alarm_log_filter
end










################ Check Licenses ################
def Check_Licenses()

    ClearMMLBuffer()
    Mail_License = "\n    Running License Check:\n"
    @DSP LICENSE:FUNCTIONTYPE=NodeB;
    mml = GetMMLReport()
    strLicense = ParseMMLRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strLicense or GetResultCode(strLicense) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strLicense), GetResultCause(strLicense)))
        Mail_License += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strLicense))+"Reason: "+ str(GetResultCause(strLicense))+"\n"
        dic.update({"Licenses":"ERROR"})
        return Mail_License,Info_log
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strLicense) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_License += '[ERROR] No proper entry information found\n'
        dic.update({"Licenses":"ERROR"})
        return Mail_License,Info_log
    end
    
    # Check Status
    OK_Count = 0
    valueLicense = GetAttrValueByName(strLicense,0,"Status",0)
    if valueLicense == 'Normal'
        Print("OK ... NE License Status: "+ str(GetAttrValueByName(strLicense,0,"Status",0)))
        Mail_License += "OK ... NE License Status: "+ str(GetAttrValueByName(strLicense,0,"Status",0))+"\n"
    else
        Print("NOK ... NE License Status: "+ str(GetAttrValueByName(strLicense,0,"Status",0)))
        Mail_License += "NOK ... NE License Status: "+ str(GetAttrValueByName(strLicense,0,"Status",0))+"\n"   
        OK_Count += 1
    end
    #List Licenses
    Mail_License +="\n    NodeB Contains the following Licenses and respective Capacity:\n"
    Num_License = GetRecordNum(strLicense,2)
    for i in range (Num_License)
        value = GetAttrValueByIdx(strLicense,2,5,i)
        if value == 'PERMANENT'
            Print("        OK ... Active License: "+ str(GetAttrValueByName(strLicense,2,"License Item",i))+" with Allocation of: "+str(GetAttrValueByName(strLicense,2,"Allocated",i)))
            Mail_License += "        OK ... Active License is "+ str(GetAttrValueByName(strLicense,2,"License Item",i))+" with Allocation of: "+str(GetAttrValueByName(strLicense,2,"Allocated",i))+"\n"
        else
            Print("        NOK ... Active License is "+ str(GetAttrValueByName(strLicense,2,"License Item",i))+" with Allocation of: "+str(GetAttrValueByName(strLicense,2,"Allocated",i)))
            Mail_License += "        NOK ... Active License is "+ str(GetAttrValueByName(strLicense,2,"License Item",i))+" with Allocation of: "+str(GetAttrValueByName(strLicense,2,"Allocated",i))+"\n"
            OK_Count += 1
        end
    end
    
    if  OK_Count <= 0
        dic.update({"Licenses":"OK"})
    else
        dic.update({"Licenses":"***** NOT OK *****"})
    end   
    
    
    return Mail_License,Info_log
end


################ Check Licenses SRAN9 ################
def Check_Licenses_SRAN9()

    ClearMMLBuffer()
    Mail_License = "\n    Running License Check:\n"
    @DSP LICENSE:FUNCTIONTYPE=NodeB;
    mml = GetMMLReport()
    strLicense = ParseMMLRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strLicense or GetResultCode(strLicense) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strLicense), GetResultCause(strLicense)))
        Mail_License += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strLicense))+"Reason: "+ str(GetResultCause(strLicense))+"\n"
        dic.update({"Licenses":"ERROR"})
        return Mail_License,Info_log
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strLicense) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_License += '[ERROR] No proper entry information found\n'
        dic.update({"Licenses":"ERROR"})
        return Mail_License,Info_log
    end
    
    # Check Status
    OK_Count = 0
    valueLicense = GetAttrValueByName(strLicense,0,"Status",0)
    if valueLicense == 'Normal'
        Print("OK ... NE License Status: "+ str(GetAttrValueByName(strLicense,0,"Status",0)))
        Mail_License += "OK ... NE License Status: "+ str(GetAttrValueByName(strLicense,0,"Status",0))+"\n"
    else
        Print("NOK ... NE License Status: "+ str(GetAttrValueByName(strLicense,0,"Status",0)))
        Mail_License += "NOK ... NE License Status: "+ str(GetAttrValueByName(strLicense,0,"Status",0))+"\n"   
        OK_Count += 1
    end
    #List Licenses
    Mail_License +="\n    NodeB Contains the following Licenses and respective Capacity:\n"
    Num_License = GetRecordNum(strLicense,2)
    for i in range (Num_License)
        value = GetAttrValueByIdx(strLicense,2,5,i)
        if value == 'PERMANENT'
            Print("        OK ... Active License: "+ str(GetAttrValueByName(strLicense,2,"License Item",i))+" with Allocation of: "+str(GetAttrValueByName(strLicense,2,"Allocated",i)))
            Mail_License += "        OK ... Active License is "+ str(GetAttrValueByName(strLicense,2,"License Item",i))+" with Allocation of: "+str(GetAttrValueByName(strLicense,2,"Allocated",i))+"\n"
        else
            Print("        NOK ... Active License is "+ str(GetAttrValueByName(strLicense,2,"License Item",i))+" with Allocation of: "+str(GetAttrValueByName(strLicense,2,"Allocated",i)))
            Mail_License += "        NOK ... Active License is "+ str(GetAttrValueByName(strLicense,2,"License Item",i))+" with Allocation of: "+str(GetAttrValueByName(strLicense,2,"Allocated",i))+"\n"
            OK_Count += 1
        end
    end
    
    if  OK_Count <= 0
        dic.update({"Licenses":"OK"})
    else
        dic.update({"Licenses":"***** NOT OK *****"})
    end   
    
    
    return Mail_License,Info_log
end






        
################ Check Software Version ################ 
def Check_SW()

    Mail_SW = "\n    Software Version Check:\n"
    @LST VER:;
    mml = GetMMLReport()
    strSW = ParseMMLRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strSW or GetResultCode(strSW) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strSW), GetResultCause(strSW)) ) 
        Mail_SW += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strSW))+"Reason: "+ str(GetResultCause(strSW))+"\n"
        dic.update({"Software Version":"ERROR"})
		dic.update({"SW_Version":"ERROR"})
        return Mail_SW,Info_log
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strSW) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_SW += '[ERROR] No proper entry information found\n'  
        dic.update({"Software Version":"ERROR"})
		dic.update({"SW_Version":"ERROR"})
        return Mail_SW,Info_log
    end
    
    # Check Status
    OK_Count = 0
    value_SW = GetAttrValueByName(strSW,0,"Current Software Status",0)
    if value_SW == 'Normal'
        Print("OK ... Current Software Version is: "+str(GetAttrValueByName(strSW,0,"Current Software Version",0))+" and the Status is: "+str(GetAttrValueByName(strSW,0,"Current Software Status",0)))
        Mail_SW += "OK ... Current Software Version is: "+str(GetAttrValueByName(strSW,0,"Current Software Version",0))+" and the Status is: "+str(GetAttrValueByName(strSW,0,"Current Software Status",0))+"\n"
    else
        Print("NOK ... Current Software Version is: "+str(GetAttrValueByName(strSW,0,"Current Software Version",0))+" and the Status is: "+str(GetAttrValueByName(strSW,0,"Current Software Status",0)))
        Mail_SW += "NOK ... Current Software Version is: "+str(GetAttrValueByName(strSW,0,"Current Software Version",0))+" and the Status is: "+str(GetAttrValueByName(strSW,0,"Current Software Status",0))+"\n"
        OK_Count += 1
    end
    
    if  OK_Count <= 0
        dic.update({"Software Version":"OK"})
    else
        dic.update({"Software Version":"***** NOT OK *****"})
    end 
        dic.update({"SW_Version":""+ str(GetAttrValueByName(strSW,0,"Current Software Version",0))})
    return Mail_SW,Info_log
end

################ Check Cell State ################ 
def Check_CellState(NEname)

    ClearMMLBuffer()
    Mail_Cell = "\n\tCell Operational State:\n"
	Print("\n\tCell Operational State:")
    #DSP UCELL:DSPT=BYNODEB,NODEBNAME="UMTS_SITE_EXAMPLE";
    CMD = ("DSP UCELL:DSPT=BYNODEB,NODEBNAME=\""+ NEName+"\";")
    #Print (CMD)
    SendMML(CMD)
    mml = GetMMLReport()
    strCell = ParseMMLRpt(mml)
    Info_log = str(mml)
	Cell_ID=[]
	
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strCell or GetResultCode(strCell) != '0' 
        Print('\t    [ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strCell), GetResultCause(strCell))) 
        Mail_Cell += "\t    [ERROR] FAILED Command Execution "+str(GetMMLCmd(strCell))+"Reason: "+ str(GetResultCause(strCell))
        dic.update({"Cells Status":"ERROR"})
		dic.update({"Cells by Operator":"ERROR"})
        return Mail_Cell,Cell_ID,Info_log
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strCell) < 1 
         Print('\t    [ERROR] No proper entry information found')
        Mail_Cell += '\t    [ERROR] No proper entry information found\n'
        dic.update({"Cells Status":"ERROR"})
		dic.update({"Cells by Operator":"ERROR"})
        return Mail_Cell,Cell_ID,Info_log
    end
    
    # Check Status
	OK_Count = 0
	
	Operator_TEF = 0
	Operator_VF = 0
	#Cell_ID_lock=[]
    Num_Cell = GetRecordNum(strCell,0)
    for l in range (Num_Cell)
        Cell_ID.append(GetAttrValueByName(strCell,0,"Cell ID",l))
		Cell_name=(GetAttrValueByName(strCell,0,"Cell name",l))
		
		if 'T' in Cell_name
			Operator_TEF += 1
		else
			Operator_VF += 1
		end
        
		
		valuestate = GetAttrValueByIdx(strCell,0,5,l)
		
        # Print(valuestate)
		if valuestate != 'Cell is not actived'
			#Cell_ID_lock.append(GetAttrValueByName(strCell,0,"Cell ID",l))
			if valuestate != 'Cell is setup and enabled'
				Print("\t    NOK ... Local Cell ID = "+ str(GetAttrValueByName(strCell,0,"Cell ID",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell name",l))+" -> "+str(GetAttrValueByIdx(strCell,0,5,l)))
				Mail_Cell += "\t    NOK ... Local Cell ID = "+ str(GetAttrValueByName(strCell,0,"Cell ID",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell name",l))+" -> "+str(GetAttrValueByIdx(strCell,0,5,l))+"\n"
				OK_Count += 1
            else
				Print("\t    OK ... Local Cell ID = "+ str(GetAttrValueByName(strCell,0,"Cell ID",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell name",l))+" -> "+str(GetAttrValueByIdx(strCell,0,5,l)))
				Mail_Cell += "\t    OK ... Local Cell ID = "+ str(GetAttrValueByName(strCell,0,"Cell ID",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell name",l))+" -> "+str(GetAttrValueByIdx(strCell,0,5,l))+"\n"
			end
		else
			Print("\t    LCK ... Local Cell ID = "+ str(GetAttrValueByName(strCell,0,"Cell ID",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell name",l))+" -> "+str(GetAttrValueByIdx(strCell,0,5,l)))
			Mail_Cell += "\t    LCK ... Local Cell ID = "+ str(GetAttrValueByName(strCell,0,"Cell ID",l))+" | Cell Name = "+ str(GetAttrValueByName(strCell,0,"Cell name",l))+" -> "+str(GetAttrValueByIdx(strCell,0,5,l))+"\n"
            OK_Count += 1
		end
    end
    #Print(Cell_ID)
	
	Mail_Cell += "\n\t    Operator_A Cells = "+str(Operator_VF)+" / Operator_B Cells = "+str(Operator_TEF)+"\n"
	dic.update({"Cells by Operator":"Operator_A Cells = "+str(Operator_VF)+" / Operator_B Cells = "+str(Operator_TEF)})
    if  OK_Count <= 0
        dic.update({"Cells Status":"OK"})
    else
        dic.update({"Cells Status":"***** NOT OK *****"})
    end     
    
    return Mail_Cell,Cell_ID,Info_log
end   


################ Check ADJNode ################ 
def Check_ADJNode(NEName)

    ClearMMLBuffer()
    Mail_ADJNode = "\n\tADJNode State:\n"
	Print("\n\tADJNode State:")
    #LST ADJNODE:LSTTYPE=BYNAME,NAME="UMTS_SITE_EXAMPLE";
    CMD = ("LST ADJNODE:LSTTYPE=BYNAME,NAME=\""+ NEName+"\";")
    #Print (CMD)
    SendMML(CMD)
    mml = GetMMLReport()
    strCell = ParseMMLRpt(mml)
    Info_log = str(mml)
	
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strCell or GetResultCode(strCell) != '0' 
        Print('\t    [ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strCell), GetResultCause(strCell))) 
        Mail_ADJNode += "\t    [ERROR] FAILED Command Execution "+str(GetMMLCmd(strCell))+"Reason: "+ str(GetResultCause(strCell))
        dic.update({"ADJNode Status":"ERROR"})
        return Mail_ADJNode,Info_log
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strCell) < 1 or "Corresponding results not found" in Info_log
        Print('\t    [ERROR] No proper entry information found')
        Mail_ADJNode += '\t    [ERROR] No proper entry information found\n'
        dic.update({"ADJNode Status":"ERROR"})
        return Mail_ADJNode,Info_log
    end
    
    # Check Status
	ADJNodeID=[]
	NodeB_ID=GetAttrValueByName(strCell,0,"NodeB ID",0)
	# Print(NodeB_ID)
	NodeB_ID_tef=int(NodeB_ID)+1
	# Print(NodeB_ID_tef)
	OK_Count=0
	
	Num_ADJ = GetRecordNum(strCell,0)
	# Print(Num_ADJ)
	for j in range (Num_ADJ)
		ADJNodeID.append(GetAttrValueByName(strCell,0,"Adjacent Node ID",j))
		Print(GetAttrValueByName(strCell,0,"Adjacent Node ID",j))
	end

	# Print(ADJNodeID)
	if Num_ADJ == 1
		if str(NodeB_ID) in ADJNodeID
			Print("\t    OK ... ADJNode = "+ ADJNodeID[0]+" | NodeB ID = "+ NodeB_ID)
			Mail_ADJNode += "\t    OK ... ADJNode = "+ ADJNodeID[0]+" | NodeB ID = "+ NodeB_ID+"\n"
		else
			Print("\t    NOK ... ADJNode = "+ ADJNodeID[0]+" | NodeB ID = "+ NodeB_ID)
			Mail_ADJNode += "\t    NOK ... ADJNode = "+ ADJNodeID[0]+" | NodeB ID = "+ NodeB_ID+"\n"
			OK_Count +=1
		end
	elif Num_ADJ == 2
		if str(NodeB_ID) in ADJNodeID and str(NodeB_ID_tef) in ADJNodeID
			Print("\t    OK ... ADJNode 1 = "+ ADJNodeID[0]+" -> NodeB ID = "+ NodeB_ID+ "| ADJNode 2 = "+ ADJNodeID[1]+" -> NodeB ID + 1 = "+ str(int(NodeB_ID) +1))
			Mail_ADJNode += "\t    OK ... ADJNode 1 = "+ ADJNodeID[0]+" -> NodeB ID = "+ NodeB_ID+ "| ADJNode 2 = "+ ADJNodeID[1]+" -> NodeB ID + 1= "+ str(int(NodeB_ID) +1)+"\n"
		else
			Print("\t    NOK ... ADJNode 1 = "+ ADJNodeID[0]+" | NodeB ID = "+ NodeB_ID+ "| ADJNode 2 = "+ ADJNodeID[1]+" -> NodeB ID +1 = "+ str(int(NodeB_ID) +1))
			Mail_ADJNode += "\t    NOK ... ADJNode 1 = "+ ADJNodeID[0]+" -> NodeB ID = "+ NodeB_ID+ "| ADJNode 2 = "+ ADJNodeID[1]+" -> NodeB ID +1 = "+ str(int(NodeB_ID) +1)+"\n"
			OK_Count +=1
		end
	else
		Print("\t    NOK ... No ADJNODE or more than 2 - Check manually" )
		Mail_ADJNode += "\t    NOK ... No ADJNODE or more than 2 - Check manually\n"
		OK_Count +=1
	end 
	
	if  OK_Count <= 0
        dic.update({"ADJNode Status":"OK"})
    else
        dic.update({"ADJNode Status":"NOT OK"}) ## Macro do excel está a espera de ***** NOT OK ***** entao tiramos os * para ter noção que deu erro mas já nao é contabilizado
    end     
    
    return Mail_ADJNode,Info_log
end 



################ Check Neighbours Relations with UTRAN Cell Intra-Frequency: ################
def Check_NeighboursUTRAN_Intra(Cell_ID)

    Mail_NeighbourUTRAN_Intra = "\n    Intra-Frequency Neighbouring Relation with UTRAN Cell:\n"
	for p in Cell_ID   
		ClearMMLBuffer()        
		CMD = ("LST UINTRAFREQNCELL:CELLID="+p+";")
		#Print (CMD)
		SendMML(CMD)
		#@LST UINTRAFREQNCELL:;
		mml = GetMMLReport()
		strNeighbourUTRAN_Intra = ParseMMLRpt(mml)
		Info_log = str(mml)
		OK_Count = 1
		
		# If MML command does not execute successfully, the system prompts error and does not continue processing  
		if not strNeighbourUTRAN_Intra or GetResultCode(strNeighbourUTRAN_Intra) != '0' 
			Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strNeighbourUTRAN_Intra), GetResultCause(strNeighbourUTRAN_Intra))) 
			Mail_NeighbourUTRAN_Intra += "[ERROR] FAILED Command Execution " +str(GetMMLCmd(strNeighbourUTRAN_Intra))+"Reason: "+ str(GetResultCause(strNeighbourUTRAN_Intra))+"\n"
			return Mail_NeighbourUTRAN_Intra,OK_Count,Info_log 
		end
		
		# If MML report has no corresponding entry information, the system prompts error and does not continue processing  
		if GetObjNum(strNeighbourUTRAN_Intra) < 1 
			Print('[ERROR] No proper entry information found')
			Mail_NeighbourUTRAN_Intra += '[ERROR] No proper entry information found\n'
			return Mail_NeighbourUTRAN_Intra,OK_Count,Info_log 
		end
		
		# Check Status
		OK_Count = 0
		Num_NeighbourUTRAN_Intra = GetRecordNum(strNeighbourUTRAN_Intra,0)
		if Num_NeighbourUTRAN_Intra <= 0
			Print("        NOK ... Intra-Frequency Neighbouring Relation with UTRAN for CellID: "+p+" is "+str(GetRecordNum(strNeighbourUTRAN_Intra,0)))
			Mail_NeighbourUTRAN_Intra += "        NOK ... Intra-Frequency Neighbouring Relation with UTRAN for CellID: "+p+" is "+str(GetRecordNum(strNeighbourUTRAN_Intra,0))+"\n"
			OK_Count += 1
		else
			Print("        OK ... Intra-Frequency Neighbouring Relation with UTRAN for CellID: "+p+" is "+str(GetRecordNum(strNeighbourUTRAN_Intra,0)))
			Mail_NeighbourUTRAN_Intra += "        OK ... Intra-Frequency Neighbouring Relation with UTRAN for CellID: "+p+" is "+str(GetRecordNum(strNeighbourUTRAN_Intra,0))+"\n"
		end
	end

    return Mail_NeighbourUTRAN_Intra,OK_Count,Info_log
end

