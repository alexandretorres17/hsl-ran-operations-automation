################ Check RF Interference ################
def Check_Interference(location)

    ClearMMLBuffer()
    Mail_RF = ""
    CMD = ("STR RFTEST:TSTTYPE=PIMOFFLINE,"+str(location))
    #Print (CMD)
    SendMML(CMD)
    #@STR RFTEST:TSTTYPE=PIMOFFLINE,CN=0,SRN=5,SN=2;
    mml = GetMMLReport(-1)
    #Print(mml)
    strRF = ParseMMLRpt(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strRF or GetResultCode(strRF) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strRF), GetResultCause(strRF)) ) 
        Mail_RF += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strRF))+"Reason: "+ str(GetResultCause(strRF))
        return Mail_RF 
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strRF) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_RF += '[ERROR] No proper entry information found\n'      
        return Mail_RF 
    end
    
    # Check Status  
    Num_RF=GetRecordNum(strRF,1)
    #Print(Num_RF)

    for m in range (Num_RF)
        CNID=GetAttrValueByIdx(strRF,1,0,m)
        SRNID=GetAttrValueByIdx(strRF,1,1,m)
        SNID=GetAttrValueByIdx(strRF,1,2,m)
        ANTID=GetAttrValueByIdx(strRF,1,3,m)
        value_RF = GetAttrValueByIdx(strRF,1,4,m)
        if value_RF != ""
            if value_RF == 'It is not interfered'
                Print("OK ... CN="+str(CNID)+",SRN="+str(SRNID)+",SN="+str(SNID)+",ANTP="+str(ANTID)+":"+str(GetAttrValueByIdx(strRF,1,4,m)))
                Mail_RF += "OK ... CN="+str(CNID)+",SRN="+str(SRNID)+",SN="+str(SNID)+",ANTP="+str(ANTID)+":"+str(GetAttrValueByIdx(strRF,1,4,m))
            else
                Print("NOK ... CN="+str(CNID)+",SRN="+str(SRNID)+",SN="+str(SNID)+",ANTP="+str(ANTID)+":"+str(GetAttrValueByIdx(strRF,1,4,m)))
                Mail_RF += "NOK ... CN="+str(CNID)+",SRN="+str(SRNID)+",SN="+str(SNID)+",ANTP="+str(ANTID)+":"+str(GetAttrValueByIdx(strRF,1,4,m))
            end
        elif value_VSWR != 'NULL' 
            Print("[ERROR] ERROR IN PARSING OUTPUT. COMMAND NEEDS TO BE PERFORMED AGAIN")
            Mail_VSWR += "[ERROR] ERROR IN PARSING OUTPUT. COMMAND NEEDS TO BE PERFORMED AGAIN\n"
        end
    end
    
    return Mail_RF
end

################ Check RF Interference ################
def Check_Board()
    
    ClearMMLBuffer()
    Mail_Board = "\n    Offline Antenna Interference Detection Test:\n"
    @DSP BRD:;
    mml = GetMMLReport()
    strBoard = ParseMMLRpt(mml)
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strBoard or GetResultCode(strBoard) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetMMLCmd(strBoard), GetResultCause(strBoard)) ) 
        Mail_Board += "[ERROR] FAILED Command Execution "+str(GetMMLCmd(strBoard))+"Reason: "+ str(GetResultCause(strBoard))+"\n"
        return Mail_Board  
    end
    
    # If MML report has no corresponding entry information, the system prompts error and does not continue processing  
    if GetObjNum(strBoard) < 1 
        Print('[ERROR] No proper entry information found')
        Mail_Board += '[ERROR] No proper entry information found\n'
        return Mail_Board  
    end
    # Check Status      
    Num_Board = GetRecordNum(strBoard,0)
    for n in range (Num_Board)
        valueboard = GetAttrValueByIdx(strBoard,0,3,n) #Board Type
        if 'RFU' in valueboard
            BRD_CNID=GetAttrValueByIdx(strBoard,0,0,n)
            BRD_SRNID=GetAttrValueByIdx(strBoard,0,1,n)
            BRD_SNID=GetAttrValueByIdx(strBoard,0,2,n)
            location = "CN="+str(BRD_CNID)+",SRN="+str(BRD_SRNID)+",SN="+str(BRD_SNID)+";"
            Mail_Bo = Check_Interference(location)
            Mail_Board += str(Mail_Bo)+"\n"
        end
    end
    
    return Mail_Board
end




