			Mail_Neighbour2G += "        NOK ... Neighbouring Relation with 2G for CellID: "+p+" is "+str(GetRecordNum(strNeighbour2G,0))+"\n"
            OK_Count += 1
		else
			Print("        OK ... Neighbouring Relation with 2G for CellID: "+p+" is "+str(GetRecordNum(strNeighbour2G,0)))
			Mail_Neighbour2G += "        OK ... Neighbouring Relation with 2G for CellID: "+p+" is "+str(GetRecordNum(strNeighbour2G,0))+"\n"
		end
    end
    return Mail_Neighbour2G,OK_Count,Info_log
