Print(Element_CoMPT)

for RNCName in RNC_Name
    
	Print(RNCName)
    i=RNC_Name.index(RNCName)
	
	# Print("i="+str(i))
	Number_of_Sites=len(NE_Name[i])
	
    # Print("Sites " +str(Number_of_Sites))
    for j in range(Number_of_Sites) 
		Element = str(NE_Name[i][j])
		Site_name=Element
		Site_name2 = []
		# Print("j="+str(j))	
		Element_UMTS = Get_ElementList(Element)
        if Element_UMTS == []
            NE_Num =  ''.join([j for j in Element if j.isdigit()]) 
            NE_Num = str(NE_Num).zfill(5)
			Print(str(Element)+"-"+str(NE_Num))
            for k in Element_CoMPT
               if NE_Num in k
                   #Print (k)
                   Site_name2.append(k)
                end
            end
            
			for site in Site_name2
				xpto=ConnectNE(site)
				# Sleep(2)
			
				ClearMMLBuffer()
				xpto=SendMML("LST NODEBFUNCTION:;")
				#Print(str(xpto))
				mml = GetMMLReport()
				strnode = ParseMMLRpt(mml)
				value_node = GetAttrValueByName(strnode,0,"NodeB Function Name",0)
				
				Print("dentro="+str(value_node))
				Print("dentro="+str(Site_name))
				if str(value_node) == str(Site_name)
					Site_name=site
				end			
			end

			Print(Site_name)
            Element_UMTS = [Element]
        end
		
        N_Cabinets = len(Element_UMTS)
		All_Path = []
        Overall_Status = "\tOverall Status \n"
        NEName_Group = []
        for NEName in Element_UMTS
			Print(NEName)
			Path,Path_Log,Overall = Main(RNCName,NEName,Site_name) 
			All_Path.append(Path)
			All_Path.append(Path_Log)
			#NEName_Group.append(NEName)
			Overall_Status += Overall +"\n"
        end
        Send_Mail(All_Path,NEName,Overall_Status)
    end
end


