################ Check Active Alarms on RNC ################
def Check_Alarms_RNC(NEName)

    ClearMMLBuffer()
    Mail_Alarms_RNC = "\n    Active Alarms Check on RNC:\n"
    @LST ALMAF:;
    mml = GetMMLReport()
    strAlarmRNC = ParseAlmRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strAlarmRNC or GetAlmResultCode(strAlarmRNC) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetAlmMMLCmd(strAlarmRNC), GetAlmResultCause(strAlarmRNC)) ) 
        Mail_Alarms_RNC += "[ERROR] FAILED Command Execution "+str(GetAlmMMLCmd(strAlarmRNC))+"Reason: "+ str(GetAlmResultCause(strAlarmRNC))+"\n"
        dic.update({"Active Alarms on RNC":"ERROR"})
        return Mail_Alarms_RNC,Info_log
    end
                  
    Mail_Alarms_P,Count = Print_Alarms_RNC(strAlarmRNC)
	
    OK_Count = 0
	if Count <= 0
        Print("OK ... No Active Alarms on the RNC from %s" %NEName)
        Mail_Alarms_RNC += ("OK ... No Active Alarms on the RNC from %s" %NEName)+"\n"
    else   
        Print("NOK ... ACTIVE ALARMS on the RNC from %s" %NEName)
        Mail_Alarms_RNC += ("NOK ... ACTIVE ALARMS on the RNC from %s" %NEName)+"\n"
		Print(Mail_Alarms_P)
        OK_Count += 1
        Mail_Alarms_RNC += Mail_Alarms_P
    end
	
    
    if  OK_Count <= 0
        dic.update({"Active Alarms on RNC":"OK"})
    else
        dic.update({"Active Alarms on RNC":"***** NOT OK *****"})
    end 
	
    
    return Mail_Alarms_RNC,Info_log
end

################ Print Active Alarms on RNC ################ 
def Print_Alarms_RNC(Alarms_Parse)
   
    Alarms_Parse
    Mail_Alarms_Print="    Site Has the Following Active Alarms on the RNC:\n"
    x=0
	NE_Num =  ''.join([i for i in NEName if i.isdigit()]) 
	# Print(NE_Num)
	for p in range(GetAlmRptNum(Alarms_Parse))
        if NE_Num in str(GetAlmLocationInfo(Alarms_Parse,p))
			x+=1
			#Print("          "+str(p+1)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+(GetAlmName(Alarms_Parse,p))+" || "+str(GetAlmLocationInfo(Alarms_Parse,p)))
			Mail_Alarms_Print += "          "+ str(x)+". -> "+str(GetAlmRaiseTime(Alarms_Parse,p))+"     "+str(GetAlmFlowNumber(Alarms_Parse,p))+" - "+str(GetAlmName(Alarms_Parse,p))+" || "+str(GetAlmLocationInfo(Alarms_Parse,p))+"\n"
		end
	end
    # Print(x)
    return Mail_Alarms_Print,x
end




################ Check Active Alarms After Tests ################
def Check_Alarms_After(NEName)

    ClearMMLBuffer()
    Mail_Alarms = "\n    Active Alarms Check After Tests:\n"
    @LST ALMAF:;
    mml = GetMMLReport()
    strAlarm = ParseAlmRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strAlarm or GetAlmResultCode(strAlarm) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetAlmMMLCmd(strAlarm), GetAlmResultCause(strAlarm)) ) 
        Mail_Alarms += "[ERROR] FAILED Command Execution "+str(GetAlmMMLCmd(strAlarm))+"Reason: "+ str(GetAlmResultCause(strAlarm))+"\n"
        dic.update({'Active Alarms After Tests':'ERROR'})
        return Mail_Alarms,Info_log
    end
    
    OK_Count = 0        
    if GetAlmRptNum(strAlarm) <= 0
        Print("OK ... No Active Alarms After Tests in %s" %NEName)
        Mail_Alarms += ("OK ... No Active Alarms After Tests in %s" %NEName)+"\n"
    else   
        Print("NOK ... ACTIVE ALARMS After Tests in %s" %NEName)
        Mail_Alarms += ("NOK ... ACTIVE ALARMS After Tests in %s" %NEName)+"\n"
		alarms_print, alarm_filter = Print_Alarms(strAlarm)
        Mail_Alarms += alarms_print
        OK_Count += 1
    end
    
	if  OK_Count <= 0
        dic.update({"Active Alarms After Tests":"OK"})
    elif alarm_filter != ""
        dic.update({"Active Alarms After Tests":"***** NOT OK *****"})
	elif alarm_filter == ""
		dic.update({"Active Alarms After Tests":"NOT OK"})
    end   
    
    return Mail_Alarms,Info_log
end

################ Check Active Alarms on RNC After Tests ################
def Check_Alarms_RNC_After(NEName)

    ClearMMLBuffer()
    Mail_Alarms_RNC = "\n    Active Alarms Check on RNC After Tests:\n"
    @LST ALMAF:;
    mml = GetMMLReport()
    strAlarmRNC = ParseAlmRpt(mml)
    Info_log = str(mml)
    
    # If MML command does not execute successfully, the system prompts error and does not continue processing  
    if not strAlarmRNC or GetAlmResultCode(strAlarmRNC) != '0' 
        Print('[ERROR] FAILED Command Execution %s. Reason: %s' %(GetAlmMMLCmd(strAlarmRNC), GetAlmResultCause(strAlarmRNC)) ) 
        Mail_Alarms_RNC += "[ERROR] FAILED Command Execution "+str(GetAlmMMLCmd(strAlarmRNC))+"Reason: "+ str(GetAlmResultCause(strAlarmRNC))+"\n"
        dic.update({"Active Alarms on RNC After Tests":"ERROR"})
        return Mail_Alarms_RNC,Info_log
    end
                  
    Mail_Alarms_P,Count = Print_Alarms_RNC(strAlarmRNC)
	
    OK_Count = 0
	if Count <= 0
        Print("OK ... No Active Alarms on the RNC After Tests from %s" %NEName)
        Mail_Alarms_RNC += ("OK ... No Active Alarms on the RNC After Tests from %s" %NEName)+"\n"
    else   
        Print("NOK ... ACTIVE ALARMS on the RNC After Tests from %s" %NEName)
        Mail_Alarms_RNC += ("NOK ... ACTIVE ALARMS on the RNC After Tests from %s" %NEName)+"\n"
		Print(Mail_Alarms_P)
        OK_Count += 1
        Mail_Alarms_RNC += Mail_Alarms_P
    end
	
    
    if  OK_Count <= 0
        dic.update({"Active Alarms on RNC After Tests":"OK"})
    else
        dic.update({"Active Alarms on RNC After Tests":"***** NOT OK *****"})
    end 
	
    
    return Mail_Alarms_RNC,Info_log
end





################ Execute all Functions ################
def ExecMMLCmd(RNCName,NEName,Site_name)
    # Send MML command to NE to obtain messages. Being restricted by the running environment, we use constant instead.  
	
	#################################################################Connect to Network Element
	
	if NEName != Site_name
		ConnectNE(Site_name)
	else
		ConnectNE(NEName)
	end
    Sleep(2)
	################ Check Maintenance Mode 
    Mail_MntMode,Info_Log_MntMode = Check_MmtMode()  
    # Mail_MntMode="\nCheck Maintenance Mode - Function Commented\n" 
    # dic.update({'Maintenance Mode':'Function Commented'})
    # Info_Log_MntMode ="\nCheck Maintenance Mode - Function Commented\n"
    
    ################ Check if there are active Alarms
    Mail_Alarms,Info_Log_Alarms = Check_Alarms(NEName)   
    # Mail_Alarms="\nCheck Active Alarms - Function Commented\n" 
    # dic.update({'Active Alarms':'Function Commented'})
    # Info_Log_Alarms ="\nCheck Active Alarms - Function Commented\n"
    
	################ Check Alarms Log
    Mail_Alarms_Log,Info_Log_Alarms_Log = Check_Alarms_Log(NEName)   
    # Mail_Alarms_Log="\nCheck Active Alarms - Function Commented\n" 
    # dic.update({'Alarms Log':'Function Commented'})
    # dic.update({'Alarms Log_10days':'Function Commented'})
    # Info_Log_Alarms_Log ="\nCheck Alarms Log - Function Commented\n"
	
	################ Check Software Version
    Mail_SW,Info_Log_SW = Check_SW()
    # Mail_SW="\nCheck Software Version - Function Commented\n"  
	# dic.update({'Software Version':'Function Commented'})
    # dic.update({'SW_Version':'Function Commented'})
    # Info_Log_SW ="\nCheck Software Version  - Function Commented\n"
	
	
	if "R009" in str(dic['SW_Version'])
		################ Check VSWR SRAN9
		# Mail_VSWR,Info_Log_VSWR = Check_VSWR_SRAN9()   
		Mail_VSWR,Info_Log_VSWR = Check_DSP_VSWR() # No Test Just Display
		# Mail_VSWR="\nCheck VSWR - Function Commented\n" 
		# Info_Log_VSWR ="\nCheck VSWR - Function Commented\n"
		# dic.update({'VSWR':'Function Commented'})	
		
		################ Check Licenses SRAN9
		Mail_License,Info_Log_License = Check_Licenses_SRAN9() 
		# Mail_License="\nCheck Licenses - Function Commented\n" 
		# dic.update({'Licenses':'Function Commented'})
		# Info_Log_License ="\nCheck Licenses  - Function Commented\n"
	
	elif "R" in str(dic['SW_Version'])
		################ Check VSWR 
		# Mail_VSWR,Info_Log_VSWR = Check_VSWR()    
		Mail_VSWR,Info_Log_VSWR = Check_DSP_VSWR() # No Test Just Display		
		# Mail_VSWR="\nCheck VSWR - Function Commented\n" 
		# Info_Log_VSWR ="\nCheck VSWR - Function Commented\n"
		# dic.update({'VSWR':'Function Commented'})	
		
		################ Check Licenses
		Mail_License,Info_Log_License = Check_Licenses() 
		# Mail_License="\nCheck Licenses - Function Commented\n" 
		# dic.update({'Licenses':'Function Commented'})
		# Info_Log_License ="\nCheck Licenses  - Function Commented\n"
	
	else
		################ Check VSWR 
		# Mail_VSWR,Info_Log_VSWR = Check_VSWR()     
		Mail_VSWR="\nCheck VSWR - Function Commented\n" 
		Info_Log_VSWR ="\nCheck VSWR - Function Commented\n"
		dic.update({'VSWR':'Function Commented'})	
		
		################ Check Licenses
		# Mail_License,Info_Log_License = Check_Licenses() 
		Mail_License="\nCheck Licenses - Function Commented\n" 
		dic.update({'Licenses':'Function Commented'})
		Info_Log_License ="\nCheck Licenses  - Function Commented\n"
	
	end
	
    	#################################################################Connect to Network Element Parent
    Print("Sleeping for 10 seconds")  
    Sleep(10) 
	ConnectNE(RNCName) 
    Sleep(3) 
   
	################ Check Alarms on RNC 
    Mail_Alarms_RNC,Info_Log_Alarms_RNC= Check_Alarms_RNC(NEName)  
    # Mail_Alarms_RNC="\nCheck Active Alarms on RNC - Function Commented\n" 
    # dic.update({'Active Alarms on RNC':'Function Commented'})    
	# Info_Log_Alarms_RNC ="\nCheck Active Alarms on RNC - Function Commented\n"
    
    ################ Check Cell State   
    Mail_Cell,Cell_ID,Info_Log_Cell = Check_CellState(NEName)  
    # Mail_Cell="\nCheck Cell State - Function Commented\n" 
    # dic.update({'Cells Status':'Function Commented'})    
    # dic.update({'Cells by Operator':'Function Commented'}) 
    # Info_Log_Cell ="\nCheck Cell State - Function Commented\n"
	
    ################ Check Neighbours Relations
    Mail_Neighbour,Info_Log_Neighbour = Check_Neighbours(Cell_ID)
    # Mail_Neighbour="\nCheck Neighbours Relations - Function Commented\n"  
	# Info_Log_Neighbour ="\nCheck Neighbours Relations - Function Commented\n"
	# dic.update({'Neighbours Relations':'Function Commented'})  
	
	################ Check ADJNode
    Mail_ADJNode,Info_log_ADJNode = Check_ADJNode(NEName)
    # Mail_Neighbour="\nCheck Neighbours Relations - Function Commented\n"  
	# Info_Log_Neighbour ="\nCheck Neighbours Relations - Function Commented\n"
	# dic.update({'Neighbours Relations':'Function Commented'}) 
	
	Sleep(10) 
	 
	################ Check Alarms on RNC After Tests
    Mail_Alarms_RNC_After,Info_Log_Alarms_RNC_After= Check_Alarms_RNC_After(NEName)  
    # Mail_Alarms_RNC_After="\nCheck Active Alarms on RNC After Tests - Function Commented\n" 
    # dic.update({'Active Alarms on RNC After Tests':'Function Commented'})    
	# Info_Log_Alarms_RNC_After ="\nCheck Active Alarms on RNC After Tests - Function Commented\n"

	if NEName != Site_name
		ConnectNE(Site_name)
	else
		ConnectNE(NEName)
	end
    Sleep(2)
    
    ################ Check if there are active Alarms After Tests
    Mail_Alarms_After,Info_Log_Alarms_After = Check_Alarms_After(NEName)   
    # Mail_Alarms_After="\nCheck Active Alarms After Tests - Function Commented\n" 
    # dic.update({'Active Alarms After Tests':'Function Commented'})
    # Info_Log_Alarms_After ="\nCheck Active Alarms After Tests - Function Commented\n"
	
	
	Info_Log=Info_Log_MntMode+Info_Log_Alarms+Info_Log_Alarms_Log+Info_Log_License+Info_Log_SW+Info_Log_VSWR+Info_Log_Cell+Info_Log_Alarms_RNC+Info_Log_Neighbour+Info_Log_Alarms_After+Info_Log_Alarms_RNC_After+Info_log_ADJNode

    #################################################################NOT IN USE
 
 	################ Check RF Interference
    #Mail_Board = Check_Board()
    #Mail_Board="\nCheck RF Interference - Function Commented\n" 
	
    ################ Check S1 Interfaces
    #Mail_S1Interface = Check_S1Interfaces()
    #Mail_S1Interface="\nCheck S1 Interfaces - Function Commented\n"     
    
    ################ Check S1-U Interface State
    #Mail_IPPath = Check_IPPath()
    #Mail_IPPath="\nCheck S1-U Interface State - Function Commented\n" 
    
     
    return Mail_MntMode,Mail_Alarms,Mail_Alarms_Log,Mail_License,Mail_SW,Mail_Cell,Mail_Neighbour,Mail_VSWR,Mail_Alarms_RNC,Info_Log,Mail_Alarms_After,Mail_Alarms_RNC_After,Mail_ADJNode
end

################ Get list with full name of the NE ################
def Get_ElementList(Element)
	
	# NE_List=GetNELstByType("BTS3900L WCDMA")	#BTS3900A WCDMA & BTS3900L WCDMA & BTS3900AL WCDMA & DBS3900 WCDMA
	NE_List=GetNELst()
	Element_Match=[]

	for i in NE_List
		if Element in i
			#Print (i)
			Element_Match.append(i)
		end
	end
	#Print(Element_Match)
	
	Element_UMTS=[]
	for j in Element_Match
		if 'UMTS' in j
			#Print (j)
			Element_UMTS.append(j)
		end
	end
	#Print(Element_UMTS)
	return Element_UMTS
end

